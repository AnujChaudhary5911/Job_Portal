
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Job Details - Job Portal</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar">
        <div class="navbar-container">
            <a href="/" class="navbar-brand">🚀 Job Portal</a>
            <ul class="nav-links">
                <li><a href="/Rdashboard">Dashboard</a></li>
                <li><a href="/recruiter/logout">Logout</a></li>
            </ul>
        </div>
    </nav>

    <!-- Container -->
    <div class="container">
        <a href="/Rdashboard" style="color: var(--primary); text-decoration: none; font-weight: 600; margin-bottom: 1rem; display: inline-block; transition: all 0.3s;">← Back</a>

        <!-- Page Header -->
        <div class="page-header">
            <h1><%= job.title %></h1>
            <p><%= job.company %></p>
        </div>

        <!-- Card -->
        <div style="background: var(--bg-card); padding: var(--space-2xl); border-radius: var(--radius-xl); box-shadow: var(--shadow-lg); margin: var(--space-2xl) auto; max-width: 900px;">
            
            <!-- Details Grid -->
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: var(--space-lg); margin-bottom: var(--space-2xl);">
                
                <div style="background: var(--bg-hover); padding: var(--space-lg); border-radius: var(--radius-lg); border-left: 4px solid var(--primary);">
                    <div style="color: var(--text-secondary); font-size: var(--font-size-xs); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: var(--space-sm);">📍 Location</div>
                    <div style="color: var(--text-primary); font-size: var(--font-size-base); font-weight: 600;"><%= job.location %></div>
                </div>

                <div style="background: var(--bg-hover); padding: var(--space-lg); border-radius: var(--radius-lg); border-left: 4px solid var(--primary);">
                    <div style="color: var(--text-secondary); font-size: var(--font-size-xs); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: var(--space-sm);">📅 Posted Date</div>
                    <div style="color: var(--text-primary); font-size: var(--font-size-base); font-weight: 600;"><%= job.postedDate %></div>
                </div>

                <div style="background: var(--bg-hover); padding: var(--space-lg); border-radius: var(--radius-lg); border-left: 4px solid var(--primary);">
                    <div style="color: var(--text-secondary); font-size: var(--font-size-xs); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: var(--space-sm);">💰 Salary</div>
                    <div style="color: var(--text-primary); font-size: var(--font-size-base); font-weight: 600;"><%= job.salary %></div>
                </div>

                <div style="background: var(--bg-hover); padding: var(--space-lg); border-radius: var(--radius-lg); border-left: 4px solid var(--primary);">
                    <div style="color: var(--text-secondary); font-size: var(--font-size-xs); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: var(--space-sm);">🏢 Company</div>
                    <div style="color: var(--text-primary); font-size: var(--font-size-base); font-weight: 600;"><%= job.company %></div>
                </div>
            </div>

            <!-- Description Section -->
            <div style="margin-top: var(--space-2xl); padding-top: var(--space-2xl); border-top: 2px solid var(--border);">
                <h2 style="color: var(--text-primary); font-size: var(--font-size-lg); font-weight: 700; margin-bottom: var(--space-lg);">📋 Job Description</h2>
                <p style="color: var(--text-secondary); font-size: var(--font-size-base); line-height: var(--line-height-relaxed);"><%= job.description %></p>
            </div>

            <!-- Action Buttons -->
            <div style="margin-top: var(--space-2xl); display: flex; gap: var(--space-md); justify-content: flex-end; flex-wrap: wrap;">
                <a href="/Rdashboard" style="padding: var(--space-md) var(--space-xl); background-color: #ecf0f1; color: var(--text-primary); border: none; border-radius: var(--radius-lg); cursor: pointer; font-weight: 600; text-decoration: none; display: inline-block; transition: all var(--transition-normal);">Back</a>
                <a href="/EditPostedJob/<%= job.id %>" style="padding: var(--space-md) var(--space-xl); background: linear-gradient(135deg, var(--primary), var(--primary-dark)); color: white; border: none; border-radius: var(--radius-lg); cursor: pointer; font-weight: 600; text-decoration: none; display: inline-block; transition: all var(--transition-normal);">Edit Job</a>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="footer">
        <div class="footer-content">
            <div class="footer-links">
                <a href="#about">About</a>
                <a href="#">Privacy Policy</a>
                <a href="#">Terms & Conditions</a>
                <a href="#">Contact</a>
            </div>
            <div class="footer-bottom">
                <p>&copy; 2026 Job Portal System. All rights reserved.</p>
            </div>
        </div>
    </footer>
</body>
</html>
