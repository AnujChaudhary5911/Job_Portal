
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Candidate Dashboard - Job Portal</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
      
        :root {
            --primary: #667eea;
            --primary-dark: #5568d3;
            --secondary: #764ba2;
            --accent: #27ae60;
            --accent-dark: #229954;
            --warning: #f39c12;
            --danger: #e74c3c;
            --danger-dark: #c0392b;
            --info: #3498db;
            --info-dark: #2980b9;
            
            --bg-primary: #f5f6fa;
            --bg-secondary: #ffffff;
            --bg-card: #ffffff;
            --bg-hover: #f8f9fa;
            --text-primary: #2c3e50;
            --text-secondary: #7f8c8d;
            --text-muted: #95a5a6;
            --border: #ecf0f1;
            
            --shadow-sm: 0 2px 10px rgba(0, 0, 0, 0.08);
            --shadow-md: 0 4px 15px rgba(0, 0, 0, 0.1);
            --shadow-lg: 0 5px 20px rgba(0, 0, 0, 0.12);
            --shadow-xl: 0 10px 40px rgba(0, 0, 0, 0.15);
            --shadow-2xl: 0 20px 60px rgba(102, 122, 211, 0.2);
            
            --transition-normal: 0.25s ease;
            --radius-lg: 12px;
            --radius-xl: 15px;
            --radius-2xl: 20px;
            --radius-full: 9999px;
            
            --font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, sans-serif;
            --z-sticky: 1020;
        }

        @media (prefers-color-scheme: dark) {
            :root {
                --bg-primary: #0f1419;
                --bg-secondary: #1e293b;
                --bg-card: #1e293b;
                --bg-hover: #334155;
                --text-primary: #f1f5f9;
                --text-secondary: #cbd5e1;
                --text-muted: #94a3b8;
                --border: #334155;
            }
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        body {
            font-family: var(--font-family);
            background-color: var(--bg-primary);
            color: var(--text-primary);
            line-height: 1.6;
            transition: background-color var(--transition-normal);
            overflow-x: hidden;
        }

        a {
            color: var(--primary);
            text-decoration: none;
            transition: color var(--transition-normal);
        }

        a:hover {
            color: var(--primary-dark);
        }

        /* ========== NAVBAR - MOBILE FIRST ==========*/
        .dashboard-navbar {
            background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
            box-shadow: var(--shadow-md);
            position: sticky;
            top: 0;
            z-index: var(--z-sticky);
        }

        .navbar-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1rem;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .navbar-brand {
            color: white;
            font-size: 24px;
            font-weight: 800;
            text-decoration: none;
            transition: transform 0.25s ease;
        }

        .navbar-brand:hover {
            transform: scale(1.05);
        }

        /* ========== HAMBURGER MENU - CSS ONLY ==========*/
        .hamburger {
            display: none;
            flex-direction: column;
            cursor: pointer;
            gap: 5px;
            background: none;
            border: none;
            padding: 0.5rem;
        }

        .hamburger span {
            width: 25px;
            height: 3px;
            background: white;
            border-radius: 2px;
            transition: all 0.3s ease;
        }

        .nav-toggle {
            display: none;
        }

        .nav-toggle:checked ~ .navbar-menu {
            max-height: 400px;
            visibility: visible;
        }

        .nav-toggle:checked ~ .hamburger span:nth-child(1) {
            transform: rotate(45deg) translate(10px, 10px);
        }

        .nav-toggle:checked ~ .hamburger span:nth-child(2) {
            opacity: 0;
        }

        .nav-toggle:checked ~ .hamburger span:nth-child(3) {
            transform: rotate(-45deg) translate(7px, -7px);
        }

        /* ========== NAVBAR MENU ==========*/
        .navbar-menu {
            display: flex;
            gap: 0;
            list-style: none;
            align-items: center;
            flex: 1;
        }

        .nav-item {
            position: relative;
        }

        .nav-link {
            color: rgba(255, 255, 255, 0.9);
            text-decoration: none;
            padding: 0.75rem 1.5rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            transition: all 0.25s ease;
            border-bottom: 3px solid transparent;
            white-space: nowrap;
            font-weight: 500;
        }

        .nav-link:hover,
        .nav-link.active {
            background-color: rgba(255, 255, 255, 0.1);
            border-bottom-color: var(--accent);
            color: white;
        }

        /* ========== USER MENU ==========*/
        .user-menu {
            display: flex;
            align-items: center;
            gap: 1.5rem;
        }

        .user-info {
            display: flex;
            align-items: center;
            gap: 1rem;
            color: white;
        }

        .user-avatar {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.2);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            border: 2px solid rgba(255, 255, 255, 0.3);
        }

        .user-name {
            font-weight: 600;
            font-size: 14px;
            display: block;
        }

        .logout-btn {
            background-color: var(--danger);
            color: white;
            border: none;
            padding: 0.5rem 1.5rem;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.25s ease;
            font-weight: 600;
            font-size: 14px;
            box-shadow: var(--shadow-sm);
            text-decoration: none;
            display: inline-block;
        }

        .logout-btn:hover {
            background-color: var(--danger-dark);
            transform: translateY(-2px);
            box-shadow: var(--shadow-lg);
        }

        /* ========== DASHBOARD CONTAINER ==========*/
        .dashboard-container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 2rem 1.5rem;
        }

        /* ========== WELCOME SECTION ==========*/
        .welcome-section {
            background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
            color: white;
            padding: 2rem;
            border-radius: 15px;
            margin-bottom: 2rem;
            box-shadow: var(--shadow-xl);
            position: relative;
            overflow: hidden;
        }

        .welcome-section::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -10%;
            width: 300px;
            height: 300px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.1);
            animation: float 6s ease-in-out infinite;
        }

        @keyframes float {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-20px); }
        }

        .welcome-section > * {
            position: relative;
            z-index: 1;
        }

        .welcome-section h1 {
            font-size: clamp(24px, 5vw, 40px);
            margin-bottom: 1rem;
            font-weight: 800;
        }

        .welcome-section p {
            font-size: clamp(14px, 2vw, 18px);
            opacity: 0.95;
            line-height: 1.7;
        }

        /* ========== STATS GRID ==========*/
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1.5rem;
            margin-bottom: 2rem;
        }

        .stat-card {
            background: var(--bg-card);
            padding: 1.5rem;
            border-radius: 12px;
            box-shadow: var(--shadow-sm);
            border-left: 5px solid var(--primary);
            transition: all 0.25s ease;
        }

        .stat-card:hover {
            transform: translateY(-8px);
            box-shadow: var(--shadow-xl);
        }

        .stat-card-icon {
            font-size: 32px;
            margin-bottom: 1rem;
        }

        .stat-card-value {
            font-size: 32px;
            font-weight: 800;
            color: var(--text-primary);
        }

        .stat-card-label {
            color: var(--text-secondary);
            font-size: 14px;
            margin-top: 0.5rem;
        }

        /* ========== DASHBOARD CONTENT ==========*/
        .dashboard-content {
            background: var(--bg-card);
            padding: 2rem;
            border-radius: 12px;
            box-shadow: var(--shadow-sm);
            margin-bottom: 2rem;
        }

        .content-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
            padding-bottom: 1.5rem;
            border-bottom: 2px solid var(--border);
            flex-wrap: wrap;
            gap: 1rem;
        }

        .content-header h2 {
            color: var(--text-primary);
            font-size: clamp(20px, 3vw, 28px);
            font-weight: 700;
        }

        .search-filter {
            display: flex;
            gap: 1rem;
            flex-wrap: wrap;
        }

        .search-input {
            padding: 0.75rem 1.5rem;
            border: 2px solid var(--border);
            border-radius: 8px;
            font-size: 14px;
            font-family: var(--font-family);
            background: var(--bg-secondary);
            color: var(--text-primary);
            transition: all 0.25s ease;
            min-width: 200px;
        }

        .search-input:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(102, 122, 211, 0.1);
        }

        .search-input::placeholder {
            color: var(--text-muted);
        }

        .filter-btn {
            padding: 0.75rem 1.5rem;
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            color: white;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 600;
            font-size: 14px;
            transition: all 0.25s ease;
            box-shadow: var(--shadow-sm);
        }

        .filter-btn:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-lg);
        }

        /* ========== JOB CARDS GRID ==========*/
        .job-cards-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 1.5rem;
        }

        /* ========== JOB CARD ==========*/
        .job-card {
            background: var(--bg-hover);
            padding: 1.5rem;
            border-radius: 12px;
            border: 2px solid var(--border);
            transition: all 0.25s ease;
            cursor: pointer;
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        .job-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.1), transparent);
            transition: left 0.5s;
            z-index: 1;
        }

        .job-card:hover::before {
            left: 100%;
        }

        .job-card:hover {
            border-color: var(--primary);
            box-shadow: var(--shadow-2xl);
            transform: translateY(-8px);
        }

        .job-card-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 1rem;
            position: relative;
            z-index: 2;
        }

        .job-title {
            font-size: 18px;
            font-weight: 700;
            color: var(--text-primary);
            margin-bottom: 0.5rem;
            line-height: 1.4;
        }

        .job-company {
            color: var(--primary);
            font-weight: 600;
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .job-meta {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            margin-bottom: 1rem;
            position: relative;
            z-index: 2;
        }

        .job-location {
            color: var(--text-secondary);
            font-size: 13px;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .job-salary {
            color: var(--accent);
            font-weight: 700;
            font-size: 14px;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .job-description {
            color: var(--text-secondary);
            font-size: 13px;
            line-height: 1.6;
            margin-bottom: 1rem;
            flex: 1;
            position: relative;
            z-index: 2;
        }

        .job-card-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-top: 1rem;
            border-top: 1px solid var(--border);
            position: relative;
            z-index: 2;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .job-posted-date {
            color: var(--text-muted);
            font-size: 12px;
            font-weight: 500;
        }

        .job-card-actions {
            display: flex;
            gap: 0.5rem;
        }

        .job-action-btn {
            padding: 0.5rem 1rem;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-size: 12px;
            font-weight: 600;
            transition: all 0.25s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }

        .apply-btn {
            background: linear-gradient(135deg, var(--accent), var(--accent-dark));
            color: white;
        }

        .apply-btn:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-lg);
        }

        .save-btn {
            background: linear-gradient(135deg, var(--warning), #e67e22);
            color: white;
        }

        .save-btn:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-lg);
        }

        /* ========== TABLE STYLES ==========*/
        .table-wrapper {
            overflow-x: auto;
            border-radius: 12px;
        }

        .dashboard-table {
            width: 100%;
            border-collapse: collapse;
            background: var(--bg-secondary);
        }

        .dashboard-table th {
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            padding: 1rem;
            text-align: left;
            color: white;
            font-weight: 600;
            font-size: 13px;
            text-transform: uppercase;
        }

        .dashboard-table td {
            padding: 1rem;
            border-bottom: 1px solid var(--border);
            color: var(--text-primary);
            font-size: 14px;
        }

        .dashboard-table tbody tr:hover {
            background: var(--bg-hover);
        }

        /* ========== STATUS BADGE ==========*/
        .status-badge {
            display: inline-block;
            padding: 6px 14px;
            border-radius: 50px;
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
        }

        .status-pending {
            background: rgba(243, 156, 18, 0.15);
            color: #d68910;
        }

        .status-approved {
            background: rgba(39, 174, 96, 0.15);
            color: var(--accent);
        }

        .status-rejected {
            background: rgba(231, 76, 60, 0.15);
            color: var(--danger);
        }

        .status-under-review {
            background: rgba(52, 152, 219, 0.15);
            color: var(--info);
        }

        /* ========== EMPTY STATE ==========*/
        .empty-state {
            text-align: center;
            padding: 3rem 1.5rem;
            background: var(--bg-card);
            border-radius: 12px;
        }

        .empty-state-icon {
            font-size: 64px;
            margin-bottom: 1rem;
        }

        .empty-state-title {
            font-size: 20px;
            color: var(--text-primary);
            margin-bottom: 0.5rem;
            font-weight: 700;
        }

        .empty-state-text {
            color: var(--text-secondary);
        }

        /* ========== RESPONSIVE - TABLET ==========*/
        @media (max-width: 1024px) {
            .dashboard-container {
                padding: 1.5rem;
            }

            .stats-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .job-cards-grid {
                grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            }

            .content-header {
                flex-direction: column;
                align-items: flex-start;
            }

            .search-filter {
                width: 100%;
            }

            .filter-btn {
                width: 100%;
            }
        }

        /* ========== RESPONSIVE - MOBILE ==========*/
        @media (max-width: 768px) {
            .navbar-header {
                padding: 1rem 0.75rem;
                gap: 0.75rem;
            }

            .navbar-brand {
                font-size: 18px;
            }

            .hamburger {
                display: flex;
            }

            .navbar-menu {
                position: absolute;
                top: 100%;
                left: 0;
                right: 0;
                background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
                flex-direction: column;
                width: 100%;
                max-height: 0;
                overflow: hidden;
                transition: max-height 0.3s ease;
                visibility: hidden;
            }

            .nav-link {
                padding: 1rem;
                border-bottom: 1px solid rgba(255, 255, 255, 0.1);
                border-right: 3px solid transparent;
            }

            .nav-link:hover,
            .nav-link.active {
                background-color: rgba(255, 255, 255, 0.1);
                border-right-color: var(--accent);
                border-bottom-color: transparent;
            }

            .user-menu {
                gap: 1rem;
            }

            .user-name {
                display: none;
            }

            .dashboard-container {
                padding: 1rem;
            }

            .welcome-section {
                padding: 1.5rem;
                margin-bottom: 1.5rem;
            }

            .welcome-section h1 {
                font-size: 20px;
            }

            .welcome-section p {
                font-size: 13px;
            }

            .stats-grid {
                grid-template-columns: 1fr;
                gap: 1rem;
            }

            .stat-card {
                padding: 1rem;
            }

            .dashboard-content {
                padding: 1rem;
                margin-bottom: 1.5rem;
            }

            .content-header {
                margin-bottom: 1rem;
                padding-bottom: 1rem;
            }

            .content-header h2 {
                font-size: 16px;
            }

            .search-input {
                min-width: 100%;
                width: 100%;
            }

            .job-cards-grid {
                grid-template-columns: 1fr;
                gap: 1rem;
            }

            .job-card {
                padding: 1rem;
            }

            .job-title {
                font-size: 16px;
            }

            .job-card-footer {
                flex-direction: column;
                align-items: stretch;
            }

            .job-card-actions {
                width: 100%;
            }

            .job-action-btn {
                flex: 1;
                justify-content: center;
            }

            .dashboard-table {
                font-size: 12px;
            }

            .dashboard-table th,
            .dashboard-table td {
                padding: 0.75rem;
            }

            .status-badge {
                font-size: 11px;
            }
        }

        /* ========== RESPONSIVE - SMALL MOBILE ==========*/
        @media (max-width: 480px) {
            .navbar-header {
                padding: 0.75rem;
            }

            .navbar-brand {
                font-size: 16px;
            }

            .logout-btn {
                padding: 0.5rem 1rem;
                font-size: 12px;
            }

            .user-avatar {
                width: 36px;
                height: 36px;
                font-size: 18px;
            }

            .dashboard-container {
                padding: 0.75rem;
            }

            .welcome-section {
                padding: 1rem;
                margin-bottom: 1rem;
            }

            .welcome-section h1 {
                font-size: 18px;
            }

            .welcome-section p {
                font-size: 12px;
            }

            .stat-card {
                padding: 1rem;
            }

            .stat-card-icon {
                font-size: 24px;
            }

            .stat-card-value {
                font-size: 24px;
            }

            .dashboard-content {
                padding: 1rem;
                margin-bottom: 1rem;
            }

            .content-header h2 {
                font-size: 15px;
            }

            .search-input {
                padding: 0.5rem 1rem;
                font-size: 13px;
            }

            .filter-btn {
                padding: 0.5rem 1rem;
                font-size: 13px;
            }

            .job-card {
                padding: 1rem;
            }

            .job-title {
                font-size: 14px;
            }

            .job-action-btn {
                padding: 0.5rem 0.75rem;
                font-size: 11px;
            }

            .dashboard-table {
                font-size: 11px;
            }

            .dashboard-table th,
            .dashboard-table td {
                padding: 8px;
            }

            .empty-state {
                padding: 2rem 1rem;
            }

            .empty-state-icon {
                font-size: 48px;
            }

            .empty-state-title {
                font-size: 16px;
            }

            .empty-state-text {
                font-size: 12px;
            }
        }

        /* ========== ACCESSIBILITY ==========*/
        @media (prefers-reduced-motion: reduce) {
            * {
                animation-duration: 0.01ms !important;
                transition-duration: 0.01ms !important;
            }
        }

        :focus-visible {
            outline: 2px solid var(--primary);
            outline-offset: 2px;
        }

        /* ========== PRINT ==========*/
        @media print {
            .dashboard-navbar,
            .search-filter,
            .job-card-actions {
                display: none;
            }

            body {
                background: white;
            }
        }
    </style>
</head>
<body>
    <!-- Dashboard Navbar -->
    <nav class="dashboard-navbar">
        <div class="navbar-header">
            <a href="/" class="navbar-brand">
    <span style="font-size: 28px; color: white;">🚀</span>
    <span style="color: white; font-weight: 800; font-size: 24px;">Job Portal</span>
</a>
            <input type="checkbox" id="nav-toggle" class="nav-toggle">
            <label for="nav-toggle" class="hamburger">
                <span></span>
                <span></span>
                <span></span>
            </label>
            <ul class="navbar-menu">
                <li class="nav-item">
                    <a href="/candidate/dashboard" class="nav-link active">📊 Dashboard</a>
                </li>
                <li class="nav-item">
                    <a href="/3" class="nav-link">📝 My Applications</a>
                </li>
                <li class="nav-item">
                    <a href="/savedJobs" class="nav-link">❤️ Saved Jobs</a>
                </li>
                <li class="nav-item">
                    <a href="/candidate/profile" class="nav-link">👤 Profile</a>
                </li>
            </ul>
            <div class="user-menu">
                <div class="user-info">
                    <div class="user-avatar">👤</div>
                    <span class="user-name"><%=name%></span>
                </div>
                <a href="/" class="logout-btn">Logout</a>
            </div>
        </div>
    </nav>

    <!-- Dashboard Content -->
    <div class="dashboard-container">
        <!-- Welcome Section -->
        <div class="welcome-section">
            <h1>Welcome back, <%=name%> 👋</h1>
            <p>Let's find you the perfect opportunity. Check out the latest jobs and manage your applications.</p>
        </div>

        <!-- Stats Grid -->
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-card-icon">📋</div>
                <div class="stat-card-value"><%=applyed%></div>
                <div class="stat-card-label">Applications Sent</div>
            </div>
            <div class="stat-card">
                <div class="stat-card-icon">💾</div>
                <div class="stat-card-value"><%=save%></div>
                <div class="stat-card-label">Jobs Saved</div>
            </div>
        </div>

        <!-- Featured Jobs Section -->
        <div class="dashboard-content">
            <div class="content-header">
                <h2>📌 Featured Job Opportunities</h2>
                <div class="search-filter">
                    <form action="/filter" method="post" style="display: flex; gap: 0.5rem; flex: 1; min-width: 100%;">
                        <input type="text" class="search-input" placeholder="Search jobs..." name="title">
                        <button type="submit" class="filter-btn">Filter</button>
                    </form>
                </div>
            </div>

            <!-- Job Cards Grid -->
            <% if (jobs && jobs.length > 0) { %>
                <div class="job-cards-grid">
                    <% jobs.forEach(job => { %>
                        <div class="job-card">
                            <div class="job-card-header">
                                <div>
                                    <div class="job-title"><%= job.title %></div>
                                    <div class="job-company"><%= job.company %></div>
                                </div>
                                <span style="font-size: 20px;">⭐</span>
                            </div>
                            <div class="job-meta">
                                <div class="job-location">📍 <%= job.location %></div>
                                <div class="job-salary">💰 <%= job.salary %></div>
                            </div>
                            <div class="job-description">
                                <%= job.description %>
                            </div>
                            <div class="job-card-footer">
                                <div class="job-posted-date">Posted <%= job.postedDate %></div>
                                <div class="job-card-actions">
                                    <a href="/applyforjob/<%=job._id%>" class="job-action-btn apply-btn">✓ Apply</a>
                                    <a href="/savejob/<%=job._id%>" class="job-action-btn save-btn">💾 Save</a>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                </div>
            <% } else { %>
                <div class="empty-state">
                    <div class="empty-state-icon">😕</div>
                    <div class="empty-state-title">No Jobs Found</div>
                    <div class="empty-state-text">No job listings available at the moment. Check back soon!</div>
                </div>
            <% } %>
        </div>

        <!-- Recent Applications Section -->
        <div class="dashboard-content">
            <div class="content-header">
                <h2>📊 Recent Applications</h2>
            </div>

            <% if (apply && apply.length > 0) { %>
                <div class="table-wrapper">
                    <table class="dashboard-table">
                        <thead>
                            <tr>
                                <th>Job Title</th>
                                <th>Company</th>
                                <th>Applied Date</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% apply.forEach(data => { %>
                                <tr>
                                    <td><strong><%= data.title %></strong></td>
                                    <td><%= data.company %></td>
                                    <td><%= data.appliedAt %></td>
                                    <td>
                                        <span class="status-badge status-<%= data.status.toLowerCase().replace(/ /g, '-') %>">
                                            <%= data.status %>
                                        </span>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <div class="empty-state">
                    <div class="empty-state-icon">📭</div>
                    <div class="empty-state-title">No Applications Yet</div>
                    <div class="empty-state-text">You haven't applied to any jobs yet. Start by exploring featured opportunities above!</div>
                </div>
            <% } %>
        </div>
    </div>
</body>
</html>
