<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Job Portal System - Find Your Dream Job</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        :root {

            --primary: #7c3aed;
            --primary-dark: #5b21b6;
            --primary-light: #a78bfa;
            --secondary: #06b6d4;
            --secondary-dark: #0891b2;
            --secondary-light: #67e8f9;
            --accent: #f43f5e;
            --accent-dark: #e11d48;
            --accent-light: #fda4af;
            --success: #10b981;
            --success-dark: #059669;
            --success-light: #6ee7b7;
            --warning: #f59e0b;

            /* Neutrals */
            --bg-primary: #faf5ff;
            --bg-secondary: #ffffff;
            --bg-card: #ffffff;
            --bg-hover: #f3e8ff;
            --text-primary: #1e1040;
            --text-secondary: #64748b;
            --text-muted: #94a3b8;
            --border: #e9d5ff;

            /* Shadows */
            --shadow-xs: 0 1px 2px rgba(0, 0, 0, 0.05);
            --shadow-sm: 0 2px 10px rgba(124, 58, 237, 0.08);
            --shadow-md: 0 4px 15px rgba(124, 58, 237, 0.1);
            --shadow-lg: 0 5px 20px rgba(124, 58, 237, 0.15);
            --shadow-xl: 0 10px 40px rgba(124, 58, 237, 0.18);
            --shadow-2xl: 0 20px 60px rgba(124, 58, 237, 0.3);

            /* Spacing */
            --space-xs: 0.25rem;
            --space-sm: 0.5rem;
            --space-md: 1rem;
            --space-lg: 1.5rem;
            --space-xl: 2rem;
            --space-2xl: 3rem;
            --space-3xl: 4rem;

            /* Border Radius */
            --radius-sm: 6px;
            --radius-md: 8px;
            --radius-lg: 12px;
            --radius-xl: 15px;
            --radius-2xl: 20px;
            --radius-full: 9999px;

            /* Typography */
            --font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, 'Roboto', sans-serif;
            --font-mono: 'JetBrains Mono', 'Monaco', monospace;

            /* Transitions */
            --transition-fast: 0.15s ease;
            --transition-normal: 0.25s ease;
            --transition-slow: 0.35s ease;

            /* Z-Index */
            --z-dropdown: 1000;
            --z-sticky: 1020;
            --z-modal: 1050;
        }

        /* Dark Mode */
        @media (prefers-color-scheme: dark) {
            :root {
                --bg-primary: #0d0a1a;
                --bg-secondary: #1a1030;
                --bg-card: #1a1030;
                --bg-hover: #2d1b5e;
                --text-primary: #f5f0ff;
                --text-secondary: #c4b5fd;
                --text-muted: #a78bfa;
                --border: #2d1b5e;
            }
        }

        /* ========== RESET & BASE STYLES ==========*/
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        body {
            font-family: var(--font-family);
            background: linear-gradient(135deg, #faf5ff 0%, #ede9fe 50%, #e0f2fe 100%);
            color: var(--text-primary);
            line-height: 1.6;
            overflow-x: hidden;
        }

        a {
            color: var(--primary);
            text-decoration: none;
            transition: color var(--transition-normal);
        }

        a:hover {
            color: var(--primary-dark);
        }

        /* ========== NAVBAR ==========*/
        .home-navbar {
            background: linear-gradient(135deg, var(--primary-dark) 0%, var(--primary) 50%, #a855f7 100%);
            box-shadow: 0 4px 24px rgba(124, 58, 237, 0.4);
            position: sticky;
            top: 0;
            z-index: var(--z-sticky);
            transition: all var(--transition-normal);
        }

        .navbar-container {
            max-width: 1400px;
            margin: 0 auto;
            padding: var(--space-lg) var(--space-xl);
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: var(--space-xl);
        }

        .navbar-brand {
            color: white;
            font-size: clamp(18px, 4vw, 28px);
            font-weight: 800;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: var(--space-md);
            letter-spacing: -1px;
            transition: transform var(--transition-normal);
        }

        .navbar-brand:hover {
            transform: scale(1.05);
        }

        .nav-links {
            display: flex;
            list-style: none;
            gap: var(--space-lg);
            align-items: center;
            flex-wrap: wrap;
        }

        .nav-links a {
            color: rgba(255, 255, 255, 0.9);
            text-decoration: none;
            padding: var(--space-sm) var(--space-lg);
            border-radius: var(--radius-lg);
            transition: all var(--transition-normal);
            font-weight: 500;
            white-space: nowrap;
        }

        .nav-links a:hover {
            background-color: rgba(255, 255, 255, 0.2);
            color: white;
            transform: translateY(-2px);
        }

        .nav-links a:nth-child(n+4) {
            background-color: rgba(255, 255, 255, 0.15);
            border: 1px solid rgba(255, 255, 255, 0.3);
        }

        .nav-links a:nth-child(4):hover {
            background-color: var(--success);
            border-color: var(--success);
        }

        .nav-links a:nth-child(5):hover {
            background-color: var(--primary);
            border-color: var(--primary);
        }

        /* ========== HERO SECTION ==========*/
        .hero-section {
            background: linear-gradient(135deg, #5b21b6 0%, #7c3aed 30%, #a855f7 65%, #06b6d4 100%);
            color: white;
            padding: clamp(3rem, 10vw, 6rem) var(--space-xl);
            text-align: center;
            min-height: 600px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            position: relative;
            overflow: hidden;
        }

        .hero-section::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -10%;
            width: 500px;
            height: 500px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.05);
            animation: float 8s ease-in-out infinite;
            z-index: 1;
        }

        .hero-section::after {
            content: '';
            position: absolute;
            bottom: -50%;
            left: -5%;
            width: 400px;
            height: 400px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.05);
            animation: float 10s ease-in-out infinite 2s;
            z-index: 1;
        }

        @keyframes float {

            0%,
            100% {
                transform: translateY(0px) rotate(0deg);
            }

            50% {
                transform: translateY(-30px) rotate(10deg);
            }
        }

        .hero-section>* {
            position: relative;
            z-index: 2;
        }

        .hero-section h1 {
            font-size: clamp(32px, 6vw, 56px);
            margin-bottom: var(--space-lg);
            font-weight: 800;
            letter-spacing: -1px;
            line-height: 1.2;
            animation: slideInDown 0.8s ease-out;
        }

        .hero-section p {
            font-size: clamp(16px, 3vw, 20px);
            opacity: 0.95;
            max-width: 650px;
            line-height: 1.8;
            margin-bottom: var(--space-2xl);
            animation: slideInUp 0.8s ease-out 0.2s both;
        }

        @keyframes slideInDown {
            from {
                opacity: 0;
                transform: translateY(-30px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes slideInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .hero-buttons {
            display: flex;
            gap: var(--space-xl);
            justify-content: center;
            flex-wrap: wrap;
            animation: slideInUp 0.8s ease-out 0.4s both;
        }

        .hero-btn {
            padding: clamp(12px, 2vw, 16px) clamp(24px, 4vw, 40px);
            font-size: clamp(14px, 2vw, 18px);
            font-weight: 600;
            border-radius: var(--radius-lg);
            text-decoration: none;
            cursor: pointer;
            transition: all var(--transition-normal);
            border: none;
            display: inline-flex;
            align-items: center;
            gap: var(--space-sm);
            box-shadow: var(--shadow-lg);
        }

        .hero-btn-candidate {
            background: linear-gradient(135deg, var(--success), var(--secondary));
            color: white;
            box-shadow: 0 8px 24px rgba(6, 182, 212, 0.4);
        }

        .hero-btn-candidate:hover {
            background: linear-gradient(135deg, var(--secondary), var(--success));
            transform: translateY(-4px);
            box-shadow: 0 16px 40px rgba(6, 182, 212, 0.5);
        }

        .hero-btn-recruiter {
            background: rgba(255, 255, 255, 0.15);
            backdrop-filter: blur(10px);
            color: white;
            border: 2px solid rgba(255, 255, 255, 0.4);
            font-weight: 700;
        }

        .hero-btn-recruiter:hover {
            background: rgba(255, 255, 255, 0.25);
            transform: translateY(-4px);
            box-shadow: 0 16px 40px rgba(255, 255, 255, 0.2);
        }

        /* ========== FEATURES SECTION ==========*/
        .features-section {
            background-color: var(--bg-primary);
            padding: clamp(3rem, 8vw, 5rem) var(--space-xl);
        }

        .features-container {
            max-width: 1400px;
            margin: 0 auto;
        }

        .section-title {
            text-align: center;
            font-size: clamp(28px, 5vw, 40px);
            color: var(--text-primary);
            margin-bottom: clamp(2rem, 5vw, 4rem);
            font-weight: 800;
            letter-spacing: -0.5px;
        }

        .section-subtitle {
            text-align: center;
            font-size: clamp(14px, 2vw, 16px);
            color: var(--text-secondary);
            margin-bottom: var(--space-2xl);
            max-width: 600px;
            margin-left: auto;
            margin-right: auto;
        }

        .features-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: var(--space-xl);
        }

        .feature-card {
            background: var(--bg-card);
            padding: var(--space-xl);
            border-radius: var(--radius-xl);
            box-shadow: var(--shadow-sm);
            border: 2px solid var(--border);
            transition: all var(--transition-normal);
            text-align: center;
            cursor: pointer;
            position: relative;
            overflow: hidden;
        }

        .feature-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 4px;
            background: linear-gradient(90deg, var(--primary), #a855f7, var(--secondary));
            transition: all var(--transition-slow);
            z-index: 1;
        }

        .feature-card:hover::before {
            height: 6px;
        }

        .feature-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 60px rgba(124, 58, 237, 0.2);
            border-color: var(--primary-light);
        }

        .feature-card>* {
            position: relative;
            z-index: 2;
        }

        .feature-icon {
            font-size: clamp(36px, 6vw, 48px);
            margin-bottom: var(--space-lg);
            display: inline-block;
            animation: bounce 2s ease-in-out infinite;
        }

        @keyframes bounce {

            0%,
            100% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-10px);
            }
        }

        .feature-card:nth-child(1) .feature-icon {
            animation-delay: 0s;
        }

        .feature-card:nth-child(2) .feature-icon {
            animation-delay: 0.2s;
        }

        .feature-card:nth-child(3) .feature-icon {
            animation-delay: 0.4s;
        }

        .feature-card:nth-child(4) .feature-icon {
            animation-delay: 0.6s;
        }

        .feature-card:nth-child(5) .feature-icon {
            animation-delay: 0.8s;
        }

        .feature-card:nth-child(6) .feature-icon {
            animation-delay: 1s;
        }

        .feature-card h3 {
            font-size: clamp(18px, 3vw, 22px);
            color: var(--text-primary);
            margin-bottom: var(--space-md);
            font-weight: 700;
        }

        .feature-card p {
            color: var(--text-secondary);
            font-size: clamp(12px, 2vw, 14px);
            line-height: 1.7;
        }

        /* ========== ABOUT SECTION ==========*/
        .about-section {
            background: var(--bg-secondary);
            padding: clamp(3rem, 8vw, 5rem) var(--space-xl);
        }

        .about-container {
            max-width: 1400px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: clamp(2rem, 5vw, 4rem);
            align-items: center;
        }

        .about-content h2 {
            font-size: clamp(28px, 4vw, 36px);
            color: var(--text-primary);
            margin-bottom: var(--space-lg);
            font-weight: 800;
            letter-spacing: -0.5px;
        }

        .about-content p {
            color: var(--text-secondary);
            font-size: clamp(13px, 2vw, 15px);
            line-height: 1.9;
            margin-bottom: var(--space-lg);
        }

        .about-highlights {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: var(--space-lg);
            margin-top: var(--space-2xl);
        }

        .highlight-item {
            display: flex;
            gap: var(--space-md);
            align-items: flex-start;
        }

        .highlight-icon {
            font-size: 24px;
            margin-top: 4px;
            flex-shrink: 0;
        }

        .highlight-item h4 {
            font-size: clamp(13px, 2vw, 15px);
            color: var(--text-primary);
            font-weight: 700;
            margin-bottom: var(--space-xs);
        }

        .highlight-item p {
            font-size: 12px;
            color: var(--text-secondary);
            margin: 0;
        }

        .about-image {
            background: linear-gradient(135deg, #5b21b6 0%, #7c3aed 50%, #06b6d4 100%);
            height: clamp(250px, 40vw, 400px);
            border-radius: var(--radius-2xl);
            display: flex;
            justify-content: center;
            align-items: center;
            color: white;
            font-size: clamp(64px, 10vw, 96px);
            box-shadow: 0 20px 60px rgba(124, 58, 237, 0.35);
            position: relative;
            overflow: hidden;
        }

        .about-image::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -20%;
            width: 300px;
            height: 300px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.1);
            animation: float 6s ease-in-out infinite;
        }

        /* ========== STATS SECTION ==========*/
        .stats-section {
            background: linear-gradient(135deg, #5b21b6 0%, #7c3aed 40%, #a855f7 70%, #06b6d4 100%);
            padding: clamp(3rem, 8vw, 5rem) var(--space-xl);
            color: white;
        }

        .stats-container {
            max-width: 1400px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: clamp(2rem, 4vw, 3rem);
            text-align: center;
        }

        .stat-item {
            position: relative;
            padding: var(--space-xl);
            border-radius: var(--radius-xl);
            background: rgba(255, 255, 255, 0.1);
            border: 2px solid rgba(255, 255, 255, 0.2);
            backdrop-filter: blur(10px);
            transition: all var(--transition-normal);
        }

        .stat-item:hover {
            background: rgba(255, 255, 255, 0.15);
            border-color: rgba(255, 255, 255, 0.4);
            transform: translateY(-4px);
        }

        .stat-item h3 {
            font-size: clamp(32px, 6vw, 48px);
            margin-bottom: var(--space-md);
            font-weight: 800;
            letter-spacing: -1px;
        }

        .stat-item p {
            font-size: clamp(13px, 2vw, 16px);
            opacity: 0.95;
            font-weight: 500;
        }

        /* ========== FOOTER ==========*/
        .footer {
            background: linear-gradient(135deg, #1e1040 0%, #0d0a1a 100%);
            color: rgba(255, 255, 255, 0.85);
            padding: clamp(2rem, 4vw, 3rem) var(--space-xl);
        }

        .footer-content {
            max-width: 1400px;
            margin: 0 auto;
        }

        .footer-top {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: var(--space-2xl);
            margin-bottom: var(--space-2xl);
        }

        .footer-section h3 {
            font-size: clamp(14px, 2vw, 16px);
            margin-bottom: var(--space-lg);
            font-weight: 700;
            color: var(--secondary-light);
        }

        .footer-section a,
        .footer-section p {
            font-size: clamp(12px, 2vw, 14px);
            color: rgba(255, 255, 255, 0.8);
            margin-bottom: var(--space-md);
            transition: color var(--transition-normal);
        }

        .footer-section a:hover {
            color: var(--primary-light);
        }

        .footer-links {
            display: flex;
            justify-content: center;
            gap: clamp(1rem, 3vw, 2rem);
            flex-wrap: wrap;
            margin-bottom: var(--space-xl);
            padding-bottom: var(--space-xl);
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        .footer-links a {
            color: rgba(255, 255, 255, 0.8);
            font-size: clamp(12px, 2vw, 14px);
        }

        .footer-bottom {
            text-align: center;
            font-size: clamp(11px, 2vw, 13px);
            opacity: 0.8;
        }

        /* ========== SCROLL TO TOP BUTTON ==========*/
        .scroll-to-top {
            position: fixed;
            bottom: 30px;
            right: 30px;
            width: 50px;
            height: 50px;
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            color: white;
            border: none;
            border-radius: 50%;
            font-size: 24px;
            cursor: pointer;
            box-shadow: var(--shadow-lg);
            opacity: 0;
            visibility: hidden;
            transition: all var(--transition-normal);
            z-index: 999;
        }

        .scroll-to-top.active {
            opacity: 1;
            visibility: visible;
        }

        .scroll-to-top:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-2xl);
        }

        /* ========== UTILITIES ==========*/
        .hidden {
            display: none !important;
        }

        .visible {
            display: block;
        }

        /* ========== RESPONSIVE DESIGN ==========*/
        @media (max-width: 1024px) {
            .navbar-container {
                padding: var(--space-lg) var(--space-lg);
            }

            .about-container {
                grid-template-columns: 1fr;
            }

            .features-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width: 768px) {
            :root {
                --space-lg: 1.2rem;
                --space-xl: 1.5rem;
                --space-2xl: 2rem;
            }

            .navbar-container {
                padding: var(--space-md);
                gap: var(--space-md);
            }

            .navbar-brand {
                font-size: 18px;
            }

            .nav-links {
                gap: var(--space-md);
                font-size: 13px;
            }

            .nav-links a {
                padding: var(--space-sm) var(--space-md);
            }

            .hero-section {
                padding: var(--space-2xl) var(--space-lg);
                min-height: 500px;
            }

            .hero-section h1 {
                margin-bottom: var(--space-lg);
            }

            .hero-section p {
                margin-bottom: var(--space-xl);
            }

            .hero-buttons {
                gap: var(--space-lg);
            }

            .features-grid {
                grid-template-columns: 1fr;
                gap: var(--space-lg);
            }

            .feature-card {
                padding: var(--space-lg);
            }

            .about-container {
                grid-template-columns: 1fr;
                gap: var(--space-xl);
            }

            .about-highlights {
                grid-template-columns: 1fr;
            }

            .stats-container {
                grid-template-columns: 1fr;
                gap: var(--space-lg);
            }

            .footer-links {
                flex-direction: column;
                gap: var(--space-md);
            }

            .scroll-to-top {
                width: 44px;
                height: 44px;
                bottom: 20px;
                right: 20px;
                font-size: 20px;
            }
        }

        @media (max-width: 480px) {
            :root {
                --space-md: 0.75rem;
                --space-lg: 1rem;
                --space-xl: 1.2rem;
                --space-2xl: 1.5rem;
            }

            .navbar-container {
                padding: var(--space-sm);
                flex-wrap: wrap;
                gap: var(--space-sm);
            }

            .navbar-brand {
                font-size: 16px;
            }

            .nav-links {
                gap: 6px;
                font-size: 11px;
            }

            .nav-links a {
                padding: 6px 10px;
            }

            .hero-section {
                padding: var(--space-xl) var(--space-md);
                min-height: 450px;
            }

            .hero-buttons {
                flex-direction: column;
                gap: var(--space-md);
                width: 100%;
            }

            .hero-btn {
                width: 100%;
            }

            .features-grid {
                grid-template-columns: 1fr;
                gap: var(--space-md);
            }

            .feature-card {
                padding: var(--space-md);
            }

            .feature-card h3 {
                font-size: 14px;
            }

            .feature-card p {
                font-size: 12px;
            }

            .about-container {
                gap: var(--space-lg);
            }

            .about-content h2 {
                font-size: 22px;
            }

            .about-content p {
                font-size: 13px;
            }

            .about-highlights {
                gap: var(--space-md);
            }

            .highlight-item h4 {
                font-size: 13px;
            }

            .stats-container {
                grid-template-columns: 1fr;
                gap: var(--space-md);
            }

            .stat-item {
                padding: var(--space-lg);
            }

            .footer-top {
                grid-template-columns: 1fr;
                gap: var(--space-lg);
            }

            .footer-links {
                flex-direction: column;
                gap: var(--space-sm);
            }

            .footer-section h3 {
                font-size: 13px;
            }

            .scroll-to-top {
                width: 40px;
                height: 40px;
                bottom: 15px;
                right: 15px;
                font-size: 18px;
            }
        }

        /* ========== ACCESSIBILITY ==========*/
        @media (prefers-reduced-motion: reduce) {
            * {
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: 0.01ms !important;
                scroll-behavior: auto !important;
            }
        }

        :focus-visible {
            outline: 2px solid var(--primary);
            outline-offset: 2px;
        }

