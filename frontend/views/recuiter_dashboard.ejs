
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Recruiter Dashboard - Job Portal</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        :root {
            --primary: #3498db;
            --primary-dark: #2980b9;
            --secondary: #2c3e50;
            --accent: #e74c3c;
            --success: #27ae60;
            --bg-primary: #f5f6fa;
            --bg-card: #ffffff;
            --bg-hover: #f8f9fa;
            --text-primary: #2c3e50;
            --text-secondary: #7f8c8d;
            --border: #ecf0f1;
            --shadow-sm: 0 2px 10px rgba(0, 0, 0, 0.08);
            --shadow-md: 0 4px 15px rgba(0, 0, 0, 0.1);
            --shadow-lg: 0 5px 20px rgba(0, 0, 0, 0.12);
            --transition-normal: 0.25s ease;
        }

        @media (prefers-color-scheme: dark) {
            :root {
                --bg-primary: #0f1419;
                --bg-card: #1e293b;
                --bg-hover: #334155;
                --text-primary: #f1f5f9;
                --text-secondary: #cbd5e1;
                --border: #334155;
            }
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, sans-serif;
            background-color: var(--bg-primary);
            color: var(--text-primary);
        }

        /* ========== NAVBAR - MOBILE FIRST ==========*/
        .dashboard-navbar {
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
            box-shadow: var(--shadow-md);
            position: sticky;
            top: 0;
            z-index: 1020;
        }

        .navbar-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1rem;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .navbar-brand {
            color: white;
            font-size: 24px;
            font-weight: 800;
            text-decoration: none;
            transition: transform 0.25s ease;
        }

        .navbar-brand:hover {
            transform: scale(1.05);
        }

        /* ========== HAMBURGER MENU - CSS ONLY ==========*/
        .hamburger {
            display: none;
            flex-direction: column;
            cursor: pointer;
            gap: 5px;
            background: none;
            border: none;
            padding: 0.5rem;
        }

        .hamburger span {
            width: 25px;
            height: 3px;
            background: white;
            border-radius: 2px;
            transition: all 0.3s ease;
        }

        /* Checkbox hack for CSS-only toggle */
        .nav-toggle {
            display: none;
        }

        .nav-toggle:checked ~ .navbar-menu {
            max-height: 400px;
            visibility: visible;
        }

        .nav-toggle:checked ~ .hamburger span:nth-child(1) {
            transform: rotate(45deg) translate(10px, 10px);
        }

        .nav-toggle:checked ~ .hamburger span:nth-child(2) {
            opacity: 0;
        }

        .nav-toggle:checked ~ .hamburger span:nth-child(3) {
            transform: rotate(-45deg) translate(7px, -7px);
        }

        /* ========== NAVBAR MENU ==========*/
        .navbar-menu {
            display: flex;
            gap: 0;
            list-style: none;
            align-items: center;
            flex: 1;
        }

        .nav-item {
            position: relative;
        }

        .nav-link {
            color: rgba(255, 255, 255, 0.9);
            text-decoration: none;
            padding: 0.75rem 1.5rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            transition: all 0.25s ease;
            border-bottom: 3px solid transparent;
            white-space: nowrap;
            font-weight: 500;
        }

        .nav-link:hover,
        .nav-link.active {
            background-color: rgba(255, 255, 255, 0.1);
            border-bottom-color: var(--accent);
            color: white;
        }

        /* ========== USER MENU ==========*/
        .user-menu {
            display: flex;
            align-items: center;
            gap: 1.5rem;
        }

        .user-info {
            display: flex;
            align-items: center;
            gap: 1rem;
            color: white;
        }

        .user-avatar {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.2);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            border: 2px solid rgba(255, 255, 255, 0.3);
        }

        .user-name {
            font-weight: 600;
            font-size: 14px;
            display: block;
        }

        .logout-btn {
            background-color: var(--accent);
            color: white;
            border: none;
            padding: 0.5rem 1.5rem;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.25s ease;
            font-weight: 600;
            font-size: 14px;
            box-shadow: var(--shadow-sm);
            text-decoration: none;
            display: inline-block;
        }

        .logout-btn:hover {
            background-color: #c0392b;
            transform: translateY(-2px);
            box-shadow: var(--shadow-lg);
        }

        /* ========== DASHBOARD CONTAINER ==========*/
        .dashboard-container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 2rem 1.5rem;
        }

        /* ========== WELCOME SECTION ==========*/
        .welcome-section {
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
            color: white;
            padding: 2rem;
            border-radius: 15px;
            margin-bottom: 2rem;
            box-shadow: var(--shadow-lg);
        }

        .welcome-section h1 {
            font-size: clamp(24px, 5vw, 40px);
            margin-bottom: 1rem;
            font-weight: 800;
        }

        .welcome-section p {
            font-size: clamp(14px, 2vw, 18px);
            opacity: 0.95;
            line-height: 1.7;
        }

        /* ========== STATS GRID ==========*/
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1.5rem;
            margin-bottom: 2rem;
        }

        .stat-card {
            background: var(--bg-card);
            padding: 1.5rem;
            border-radius: 12px;
            box-shadow: var(--shadow-sm);
            border-left: 5px solid var(--primary);
            transition: all 0.25s ease;
        }

        .stat-card:hover {
            transform: translateY(-8px);
            box-shadow: var(--shadow-lg);
        }

        .stat-card-icon {
            font-size: 32px;
            margin-bottom: 1rem;
        }

        .stat-card-value {
            font-size: 32px;
            font-weight: 800;
            color: var(--text-primary);
        }

        .stat-card-label {
            color: var(--text-secondary);
            font-size: 14px;
            margin-top: 0.5rem;
        }

        /* ========== DASHBOARD CONTENT ==========*/
        .dashboard-content {
            background: var(--bg-card);
            padding: 2rem;
            border-radius: 12px;
            box-shadow: var(--shadow-sm);
            margin-bottom: 2rem;
        }

        .content-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
            padding-bottom: 1.5rem;
            border-bottom: 2px solid var(--border);
            flex-wrap: wrap;
            gap: 1rem;
        }

        .content-header h2 {
            color: var(--text-primary);
            font-size: clamp(20px, 3vw, 28px);
            font-weight: 700;
        }

        .header-actions {
            display: flex;
            gap: 1rem;
            flex-wrap: wrap;
        }

        .post-job-btn {
            padding: 0.75rem 1.5rem;
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            color: white;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 600;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            transition: all 0.25s ease;
            box-shadow: var(--shadow-sm);
        }

        .post-job-btn:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-lg);
        }

        /* ========== TABLE ==========*/
        .table-wrapper {
            overflow-x: auto;
            border-radius: 12px;
        }

        .dashboard-table {
            width: 100%;
            border-collapse: collapse;
            background: var(--bg-card);
        }

        .dashboard-table th {
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            padding: 1rem;
            text-align: left;
            color: white;
            font-weight: 600;
            font-size: 13px;
            text-transform: uppercase;
        }

        .dashboard-table td {
            padding: 1rem;
            border-bottom: 1px solid var(--border);
            color: var(--text-primary);
            font-size: 14px;
        }

        .dashboard-table tbody tr:hover {
            background: var(--bg-hover);
        }

        /* ========== ACTION BUTTONS ==========*/
        .action-btn {
            padding: 8px 12px;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-size: 12px;
            font-weight: 600;
            margin-right: 6px;
            text-decoration: none;
            display: inline-block;
            transition: all 0.25s ease;
        }

        .view-btn {
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            color: white;
        }

        .view-btn:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-lg);
        }

        .edit-btn {
            background: linear-gradient(135deg, #f39c12, #e67e22);
            color: white;
        }

        .edit-btn:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-lg);
        }

        .delete-btn {
            background: linear-gradient(135deg, var(--accent), #c0392b);
            color: white;
        }

        .delete-btn:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-lg);
        }

        /* ========== APPLICANTS GRID ==========*/
        .applicants-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 1.5rem;
        }

        .applicant-card {
            background: var(--bg-hover);
            padding: 1.5rem;
            border-radius: 12px;
            border: 2px solid var(--border);
            transition: all 0.25s ease;
        }

        .applicant-card:hover {
            border-color: var(--primary);
            box-shadow: var(--shadow-lg);
            transform: translateY(-8px);
        }

        .applicant-header {
            display: flex;
            align-items: center;
            margin-bottom: 1rem;
            gap: 1rem;
        }

        .applicant-avatar {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 28px;
            border: 3px solid white;
            box-shadow: var(--shadow-md);
            flex-shrink: 0;
        }

        .applicant-info h4 {
            color: var(--text-primary);
            font-size: 16px;
            font-weight: 700;
        }

        .applicant-info p {
            color: var(--text-secondary);
            font-size: 12px;
        }

        .applicant-job {
            background: var(--bg-card);
            padding: 1rem;
            border-radius: 8px;
            margin-bottom: 1rem;
            border-left: 4px solid var(--primary);
        }

        .applicant-job-title {
            font-size: 14px;
            font-weight: 700;
            color: var(--text-primary);
        }

        .applicant-status {
            display: inline-block;
            padding: 4px 10px;
            border-radius: 50px;
            font-size: 11px;
            font-weight: 600;
            background: rgba(52, 152, 219, 0.15);
            color: var(--primary);
            margin-top: 0.5rem;
        }

        .applicant-actions {
            display: flex;
            gap: 1rem;
        }

        .accept-btn,
        .reject-btn {
            flex: 1;
            padding: 0.75rem;
            color: white;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 600;
            font-size: 13px;
            text-decoration: none;
            display: inline-block;
            transition: all 0.25s ease;
        }

        .accept-btn {
            background: linear-gradient(135deg, var(--success), #229954);
        }

        .accept-btn:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-lg);
        }

        .reject-btn {
            background: linear-gradient(135deg, var(--accent), #c0392b);
        }

        .reject-btn:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-lg);
        }

        /* ========== EMPTY STATE ==========*/
        .empty-state {
            text-align: center;
            padding: 3rem 1.5rem;
            background: var(--bg-card);
            border-radius: 12px;
        }

        .empty-state-icon {
            font-size: 64px;
            margin-bottom: 1rem;
        }

        .empty-state-title {
            font-size: 20px;
            color: var(--text-primary);
            margin-bottom: 0.5rem;
            font-weight: 700;
        }

        .empty-state-text {
            color: var(--text-secondary);
            margin-bottom: 1.5rem;
        }

        /* ========== RESPONSIVE - TABLET ==========*/
        @media (max-width: 1024px) {
            .dashboard-container {
                padding: 1.5rem;
            }

            .stats-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .applicants-grid {
                grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            }

            .content-header {
                flex-direction: column;
                align-items: flex-start;
            }

            .header-actions {
                width: 100%;
            }

            .post-job-btn {
                width: 100%;
                justify-content: center;
            }
        }

        /* ========== RESPONSIVE - MOBILE ==========*/
        @media (max-width: 768px) {
            .navbar-header {
                padding: 1rem 0.75rem;
                gap: 0.75rem;
            }

            .navbar-brand {
                font-size: 18px;
            }

            /* Show Hamburger */
            .hamburger {
                display: flex;
            }

            /* Hide Menu by Default */
            .navbar-menu {
                position: absolute;
                top: 100%;
                left: 0;
                right: 0;
                background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
                flex-direction: column;
                width: 100%;
                max-height: 0;
                overflow: hidden;
                transition: max-height 0.3s ease;
                visibility: hidden;
            }

            .nav-link {
                padding: 1rem;
                border-bottom: 1px solid rgba(255, 255, 255, 0.1);
                border-right: 3px solid transparent;
            }

            .nav-link:hover,
            .nav-link.active {
                background-color: rgba(255, 255, 255, 0.1);
                border-right-color: var(--accent);
                border-bottom-color: transparent;
            }

            .user-menu {
                gap: 1rem;
            }

            .user-name {
                display: none;
            }

            .dashboard-container {
                padding: 1rem;
            }

            .welcome-section {
                padding: 1.5rem;
                margin-bottom: 1.5rem;
            }

            .welcome-section h1 {
                font-size: 20px;
            }

            .welcome-section p {
                font-size: 13px;
            }

            .stats-grid {
                grid-template-columns: 1fr;
                gap: 1rem;
            }

            .stat-card {
                padding: 1rem;
            }

            .dashboard-content {
                padding: 1rem;
                margin-bottom: 1.5rem;
            }

            .content-header {
                margin-bottom: 1rem;
                padding-bottom: 1rem;
            }

            .content-header h2 {
                font-size: 16px;
            }

            .post-job-btn {
                width: 100%;
                font-size: 13px;
                padding: 0.75rem 1rem;
            }

            .applicants-grid {
                grid-template-columns: 1fr;
                gap: 1rem;
            }

            .applicant-card {
                padding: 1rem;
            }

            .applicant-avatar {
                width: 50px;
                height: 50px;
                font-size: 24px;
            }

            .action-btn {
                padding: 6px 10px;
                font-size: 11px;
                margin-right: 4px;
            }

            .dashboard-table {
                font-size: 12px;
            }

            .dashboard-table th,
            .dashboard-table td {
                padding: 0.75rem;
            }

            .accept-btn,
            .reject-btn {
                padding: 0.5rem;
                font-size: 12px;
            }
        }

        /* ========== RESPONSIVE - SMALL MOBILE ==========*/
        @media (max-width: 480px) {
            .navbar-header {
                padding: 0.75rem;
            }

            .navbar-brand {
                font-size: 16px;
            }

            .logout-btn {
                padding: 0.5rem 1rem;
                font-size: 12px;
            }

            .user-avatar {
                width: 36px;
                height: 36px;
                font-size: 18px;
            }

            .dashboard-container {
                padding: 0.75rem;
            }

            .welcome-section {
                padding: 1rem;
                margin-bottom: 1rem;
            }

            .welcome-section h1 {
                font-size: 18px;
            }

            .welcome-section p {
                font-size: 12px;
            }

            .stat-card {
                padding: 1rem;
            }

            .stat-card-icon {
                font-size: 24px;
            }

            .stat-card-value {
                font-size: 24px;
            }

            .dashboard-content {
                padding: 1rem;
                margin-bottom: 1rem;
            }

            .content-header h2 {
                font-size: 15px;
            }

            .applicant-card {
                padding: 1rem;
            }

            .accept-btn,
            .reject-btn {
                padding: 0.5rem 0.75rem;
                font-size: 11px;
            }

            .action-btn {
                padding: 5px 8px;
                font-size: 10px;
            }
        }

        /* ========== ACCESSIBILITY ==========*/
        @media (prefers-reduced-motion: reduce) {
            * {
                animation-duration: 0.01ms !important;
                transition-duration: 0.01ms !important;
            }
        }

        :focus-visible {
            outline: 2px solid var(--primary);
            outline-offset: 2px;
        }

        /* ========== PRINT ==========*/
        @media print {
            .dashboard-navbar,
            .header-actions,
            .applicant-actions {
                display: none;
            }

            body {
                background: white;
            }
        }
    </style>
</head>
<body>
    <!-- Dashboard Navbar -->
    <nav class="dashboard-navbar">
        <div class="navbar-header">
            <a href="/" class="navbar-brand">🚀 Job Portal</a>
            <input type="checkbox" id="nav-toggle" class="nav-toggle">
            <label for="nav-toggle" class="hamburger">
                <span></span>
                <span></span>
                <span></span>
            </label>
            <ul class="navbar-menu">
                <li class="nav-item">
                    <a href="/recruiter/dashboard" class="nav-link active">📊 Dashboard</a>
                </li>
                <li class="nav-item">
                    <a href="/recruiter/post-job" class="nav-link">➕ Post Job</a>
                </li>
                <li class="nav-item">
                    <a href="/recruiter/view-posted-jobs" class="nav-link">📋 My Jobs</a>
                </li>
                <li class="nav-item">
                    <a href="/recruiter/view-applicants" class="nav-link">👥 Applicants</a>
                </li>
            </ul>
            <div class="user-menu">
                <div class="user-info">
                    <div class="user-avatar">👔</div>
                    <span class="user-name"><%=name%></span>
                </div>
                <a href="/" class="logout-btn">Logout</a>
            </div>
        </div>
    </nav>

    <!-- Dashboard Content -->
    <div class="dashboard-container">
        <!-- Welcome Section -->
        <div class="welcome-section">
            <h1>Welcome back, <%=name%>! 👋</h1>
            <p>Manage your job postings, review applicants, and find the perfect candidates for your company.</p>
        </div>

        <!-- Stats Grid -->
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-card-icon">📢</div>
                <div class="stat-card-value"><%=posted%></div>
                <div class="stat-card-label">Jobs Posted</div>
            </div>
            <div class="stat-card">
                <div class="stat-card-icon">👥</div>
                <div class="stat-card-value"><%=Applicants%></div>
                <div class="stat-card-label">Total Applicants</div>
            </div>
        </div>

        <!-- Posted Jobs Section -->
        <div class="dashboard-content">
            <div class="content-header">
                <h2>📋 Your Job Postings</h2>
                <div class="header-actions">
                    <a href="/recruiter/post-job" class="post-job-btn">➕ Post New Job</a>
                </div>
            </div>

            <% if (job && job.length > 0) { %>
                <div class="table-wrapper">
                    <table class="dashboard-table">
                        <thead>
                            <tr>
                                <th>Job Title</th>
                                <th>Location</th>
                                <th>Salary</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% job.forEach(jobItem => { %>
                                <tr>
                                    <td class="job-title-cell"><%= jobItem.title %></td>
                                    <td><%= jobItem.location %></td>
                                    <td><%= jobItem.salary %></td>
                                    <td>
                                        <a href="/viewpostedJob/<%= jobItem._id %>" class="action-btn view-btn">👁️ View</a>
                                        <a href="/EditPostedJob/<%= jobItem._id %>" class="action-btn edit-btn">✏️ Edit</a>
                                        <a href="/deletePosted/<%= jobItem._id %>" class="action-btn delete-btn">🗑️ Delete</a>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <div class="empty-state">
                    <div class="empty-state-icon">📭</div>
                    <div class="empty-state-title">No Jobs Posted Yet</div>
                    <div class="empty-state-text">Start by posting your first job listing to attract qualified candidates!</div>
                </div>
            <% } %>
        </div>

        <!-- Recent Applicants Section -->
        <div class="dashboard-content">
            <div class="content-header">
                <h2>👥 Recent Applicants</h2>
            </div>

            <% if (user1 && user1.length > 0) { %>
                <div class="applicants-grid">
                    <% user1.forEach(user => { %>
                        <div class="applicant-card">
                            <div class="applicant-header">
                                <div class="applicant-avatar">👨</div>
                                <div class="applicant-info">
                                    <h4><%= user.name %></h4>
                                    <p class="applicant-email"><%= user.candidate %></p>
                                </div>
                            </div>
                            <div class="applicant-job">
                                <div class="applicant-job-title"><%= user.title %></div>
                                <div class="applicant-status"><%= user.status %></div>
                            </div>
                            <div class="applicant-actions">
                                <a href="/Accept/<%= user._id %>" class="accept-btn">✓ Accept</a>
                                <a href="/Reject/<%= user._id %>" class="reject-btn">✕ Reject</a>
                            </div>
                        </div>
                    <% }); %>
                </div>
            <% } else { %>
                <div class="empty-state">
                    <div class="empty-state-icon">📭</div>
                    <div class="empty-state-title">No Applicants Yet</div>
                    <div class="empty-state-text">Your applicants will appear here as they apply to your job listings.</div>
                </div>
            <% } %>
        </div>
    </div>
</body>
