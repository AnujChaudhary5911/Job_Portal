<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Recruiter Dashboard - Job Portal</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        /* ================================================
           PROFESSIONAL RECRUITER DASHBOARD v3.0
           ✨ Enterprise Grade | Dark Mode | Mobile First
           ================================================ */

        /* CSS Custom Properties */
        :root {
            /* Colors - Blue Theme for Recruiter */
            --primary: #3498db;
            --primary-dark: #2980b9;
            --primary-light: #5dade2;
            --secondary: #2c3e50;
            --accent: #e74c3c;
            --accent-dark: #c0392b;
            --accent-light: #ec7063;
            --success: #27ae60;
            --success-dark: #229954;
            --success-light: #52be80;
            --warning: #f39c12;
            --info: #3498db;
            
            /* Neutrals */
            --bg-primary: #f5f6fa;
            --bg-secondary: #ffffff;
            --bg-card: #ffffff;
            --bg-hover: #f8f9fa;
            --bg-overlay: rgba(0, 0, 0, 0.7);
            --text-primary: #2c3e50;
            --text-secondary: #7f8c8d;
            --text-muted: #95a5a6;
            --border: #ecf0f1;
            --border-light: #f1f5f9;
            
            /* Shadows */
            --shadow-xs: 0 1px 2px rgba(0, 0, 0, 0.05);
            --shadow-sm: 0 2px 10px rgba(0, 0, 0, 0.08);
            --shadow-md: 0 4px 15px rgba(0, 0, 0, 0.1);
            --shadow-lg: 0 5px 20px rgba(0, 0, 0, 0.12);
            --shadow-xl: 0 10px 40px rgba(0, 0, 0, 0.15);
            --shadow-2xl: 0 20px 60px rgba(52, 152, 219, 0.2);
            
            /* Spacing */
            --space-xs: 0.25rem;
            --space-sm: 0.5rem;
            --space-md: 1rem;
            --space-lg: 1.5rem;
            --space-xl: 2rem;
            --space-2xl: 3rem;
            --space-3xl: 4rem;
            
            /* Border Radius */
            --radius-sm: 6px;
            --radius-md: 8px;
            --radius-lg: 12px;
            --radius-xl: 15px;
            --radius-2xl: 20px;
            --radius-full: 9999px;
            
            /* Typography */
            --font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, 'Roboto', sans-serif;
            --font-mono: 'JetBrains Mono', 'Monaco', monospace;
            
            /* Transitions */
            --transition-fast: 0.15s ease;
            --transition-normal: 0.25s ease;
            --transition-slow: 0.35s ease;
            
            /* Z-Index */
            --z-dropdown: 1000;
            --z-sticky: 1020;
            --z-modal: 1050;
        }

        /* Dark Mode */
        @media (prefers-color-scheme: dark) {
            :root {
                --bg-primary: #0f1419;
                --bg-secondary: #1e293b;
                --bg-card: #1e293b;
                --bg-hover: #334155;
                --text-primary: #f1f5f9;
                --text-secondary: #cbd5e1;
                --text-muted: #94a3b8;
                --border: #334155;
                --border-light: #475569;
            }
        }

        /* ========== RESET & BASE STYLES ==========*/
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        body {
            font-family: var(--font-family);
            background-color: var(--bg-primary);
            color: var(--text-primary);
            line-height: 1.6;
            transition: background-color var(--transition-normal);
            overflow-x: hidden;
        }

        a {
            color: var(--primary);
            text-decoration: none;
            transition: color var(--transition-normal);
        }

        a:hover {
            color: var(--primary-dark);
        }

        /* ========== NAVBAR ==========*/
        .dashboard-navbar {
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
            box-shadow: var(--shadow-md);
            position: sticky;
            top: 0;
            z-index: var(--z-sticky);
            transition: all var(--transition-normal);
        }

        .navbar-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: var(--space-lg) var(--space-xl);
            max-width: 1400px;
            margin: 0 auto;
            width: 100%;
        }

        .navbar-brand {
            color: white;
            font-size: clamp(18px, 4vw, 28px);
            font-weight: 800;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: var(--space-md);
            letter-spacing: -1px;
            transition: transform var(--transition-normal);
        }

        .navbar-brand:hover {
            transform: scale(1.05);
        }

        .navbar-menu {
            display: flex;
            gap: 0;
            list-style: none;
            align-items: center;
        }

        .nav-item {
            position: relative;
        }

        .nav-link {
            color: rgba(255, 255, 255, 0.9);
            text-decoration: none;
            padding: var(--space-md) var(--space-lg);
            display: flex;
            align-items: center;
            gap: var(--space-sm);
            transition: all var(--transition-normal);
            border-bottom: 3px solid transparent;
            font-weight: 500;
            white-space: nowrap;
        }

        .nav-link:hover {
            background-color: rgba(255, 255, 255, 0.1);
            border-bottom-color: var(--accent);
            transform: translateY(-2px);
        }

        .nav-link.active {
            background-color: rgba(255, 255, 255, 0.15);
            border-bottom-color: var(--accent);
            color: white;
        }

        .user-menu {
            display: flex;
            align-items: center;
            gap: var(--space-lg);
        }

        .user-info {
            display: flex;
            align-items: center;
            gap: var(--space-md);
            color: white;
        }

        .user-avatar {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.2);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            border: 2px solid rgba(255, 255, 255, 0.3);
            transition: all var(--transition-normal);
        }

        .user-avatar:hover {
            background: rgba(255, 255, 255, 0.3);
            transform: scale(1.1);
        }

        .user-name {
            font-weight: 600;
            font-size: 14px;
        }

        .logout-btn {
            background-color: var(--accent);
            color: white;
            border: none;
            padding: var(--space-sm) var(--space-lg);
            border-radius: var(--radius-lg);
            cursor: pointer;
            transition: all var(--transition-normal);
            font-weight: 600;
            font-size: 14px;
            box-shadow: var(--shadow-sm);
        }

        .logout-btn:hover {
            background-color: var(--accent-dark);
            transform: translateY(-2px);
            box-shadow: var(--shadow-lg);
        }

        /* ========== DASHBOARD CONTAINER ==========*/
        .dashboard-container {
            max-width: 1400px;
            margin: 0 auto;
            padding: var(--space-xl) var(--space-lg);
        }

        /* ========== WELCOME SECTION ==========*/
        .welcome-section {
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
            color: white;
            padding: clamp(2rem, 5vw, 3rem);
            border-radius: var(--radius-2xl);
            margin-bottom: var(--space-2xl);
            box-shadow: var(--shadow-xl);
            position: relative;
            overflow: hidden;
        }

        .welcome-section::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -10%;
            width: 300px;
            height: 300px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.1);
            animation: float 6s ease-in-out infinite;
        }

        @keyframes float {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-20px); }
        }

        .welcome-section > * {
            position: relative;
            z-index: 1;
        }

        .welcome-section h1 {
            font-size: clamp(24px, 5vw, 40px);
            margin-bottom: var(--space-md);
            font-weight: 800;
            letter-spacing: -0.5px;
        }

        .welcome-section p {
            font-size: clamp(14px, 2vw, 18px);
            opacity: 0.95;
            max-width: 600px;
            line-height: 1.7;
        }

        /* ========== STATS GRID ==========*/
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: var(--space-lg);
            margin-bottom: var(--space-2xl);
        }

        .stat-card {
            background: var(--bg-card);
            padding: var(--space-xl);
            border-radius: var(--radius-xl);
            box-shadow: var(--shadow-sm);
            border-left: 5px solid var(--primary);
            transition: all var(--transition-normal);
            cursor: pointer;
        }

        .stat-card:hover {
            transform: translateY(-8px);
            box-shadow: var(--shadow-xl);
        }

        .stat-card.posted {
            border-left-color: var(--success);
        }

        .stat-card.applicants {
            border-left-color: var(--accent);
        }

        .stat-card.views {
            border-left-color: var(--warning);
        }

        .stat-card-icon {
            font-size: clamp(28px, 5vw, 40px);
            margin-bottom: var(--space-md);
            display: inline-block;
        }

        .stat-card-value {
            font-size: clamp(24px, 4vw, 32px);
            font-weight: 800;
            color: var(--text-primary);
            margin-bottom: var(--space-xs);
        }

        .stat-card-label {
            color: var(--text-secondary);
            font-size: 14px;
            font-weight: 500;
        }

        /* ========== DASHBOARD CONTENT ==========*/
        .dashboard-content {
            background: var(--bg-card);
            padding: var(--space-xl);
            border-radius: var(--radius-xl);
            box-shadow: var(--shadow-sm);
            margin-bottom: var(--space-2xl);
            transition: all var(--transition-normal);
        }

        .content-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: var(--space-xl);
            padding-bottom: var(--space-lg);
            border-bottom: 2px solid var(--border);
            flex-wrap: wrap;
            gap: var(--space-lg);
        }

        .content-header h2 {
            color: var(--text-primary);
            font-size: clamp(20px, 3vw, 28px);
            font-weight: 700;
        }

        .header-actions {
            display: flex;
            gap: var(--space-md);
            flex-wrap: wrap;
        }

        .search-input {
            padding: var(--space-md) var(--space-lg);
            border: 2px solid var(--border);
            border-radius: var(--radius-lg);
            font-size: 14px;
            font-family: var(--font-family);
            background: var(--bg-secondary);
            color: var(--text-primary);
            transition: all var(--transition-normal);
            min-width: 200px;
        }

        .search-input:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(52, 152, 219, 0.1);
            transform: translateY(-1px);
        }

        .search-input::placeholder {
            color: var(--text-muted);
        }

        .post-job-btn {
            padding: var(--space-md) var(--space-xl);
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            color: white;
            border: none;
            border-radius: var(--radius-lg);
            cursor: pointer;
            font-weight: 600;
            font-size: 14px;
            transition: all var(--transition-normal);
            box-shadow: var(--shadow-sm);
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: var(--space-sm);
        }

        .post-job-btn:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-lg);
        }

        .post-job-btn:active {
            transform: translateY(0);
        }

        /* ========== TABLE STYLES ==========*/
        .table-wrapper {
            overflow-x: auto;
            border-radius: var(--radius-lg);
            position: relative;
            z-index: 1;
        }

        .dashboard-table {
            width: 100%;
            border-collapse: collapse;
            background: var(--bg-secondary);
            border-radius: var(--radius-lg);
            overflow: hidden;
        }

        .dashboard-table th {
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            padding: var(--space-lg);
            text-align: left;
            color: white;
            font-weight: 600;
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            position: sticky;
            top: 0;
        }

        .dashboard-table td {
            padding: var(--space-lg);
            border-bottom: 1px solid var(--border);
            color: var(--text-primary);
            font-size: 14px;
        }

        .dashboard-table tr {
            transition: all var(--transition-normal);
        }

        .dashboard-table tbody tr:hover {
            background: var(--bg-hover);
            box-shadow: inset 0 0 10px rgba(52, 152, 219, 0.1);
        }

        .dashboard-table tbody tr:last-child td {
            border-bottom: none;
        }

        .job-title-cell {
            font-weight: 600;
            color: var(--text-primary);
        }

        .applicant-count {
            display: inline-block;
            padding: 6px 14px;
            background-color: var(--accent);
            color: white;
            border-radius: var(--radius-full);
            font-size: 12px;
            font-weight: 600;
            text-align: center;
        }

        /* ========== ACTION BUTTONS ==========*/
        .action-btn {
            padding: 8px 14px;
            border: none;
            border-radius: var(--radius-lg);
            cursor: pointer;
            font-size: 12px;
            font-weight: 600;
            transition: all var(--transition-normal);
            margin-right: 6px;
            display: inline-flex;
            align-items: center;
            gap: 4px;
            text-decoration: none;
        }

        .view-btn {
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            color: white;
        }

        .view-btn:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-lg);
        }

        .edit-btn {
            background: linear-gradient(135deg, var(--warning), #e67e22);
            color: white;
        }

        .edit-btn:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-lg);
        }

        .delete-btn {
            background: linear-gradient(135deg, var(--accent), var(--accent-dark));
            color: white;
        }

        .delete-btn:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-lg);
        }

        /* ========== APPLICANTS GRID ==========*/
        .applicants-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: var(--space-lg);
            animation: fadeIn 0.5s ease-out;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* ========== APPLICANT CARD ==========*/
        .applicant-card {
            background: var(--bg-hover);
            padding: var(--space-lg);
            border-radius: var(--radius-lg);
            border: 2px solid var(--border);
            transition: all var(--transition-normal);
            cursor: pointer;
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        .applicant-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.1), transparent);
            transition: left 0.5s;
            z-index: 1;
        }

        .applicant-card:hover::before {
            left: 100%;
        }

        .applicant-card:hover {
            border-color: var(--primary);
            box-shadow: var(--shadow-2xl);
            transform: translateY(-8px);
        }

        .applicant-header {
            display: flex;
            align-items: center;
            margin-bottom: var(--space-lg);
            gap: var(--space-lg);
            position: relative;
            z-index: 2;
        }

        .applicant-avatar {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 28px;
            border: 3px solid white;
            box-shadow: var(--shadow-md);
            flex-shrink: 0;
        }

        .applicant-info {
            flex: 1;
            position: relative;
            z-index: 2;
        }

        .applicant-info h4 {
            color: var(--text-primary);
            margin-bottom: var(--space-xs);
            font-size: 16px;
            font-weight: 700;
        }

        .applicant-info p {
            color: var(--text-secondary);
            font-size: 12px;
            margin-bottom: 2px;
        }

        .applicant-email {
            color: var(--primary);
            font-size: 12px;
            font-weight: 600;
        }

        .applicant-job {
            background: var(--bg-secondary);
            padding: var(--space-md);
            border-radius: var(--radius-lg);
            margin-bottom: var(--space-lg);
            border-left: 4px solid var(--primary);
            position: relative;
            z-index: 2;
        }

        .applicant-job-title {
            font-size: 14px;
            font-weight: 700;
            color: var(--text-primary);
            margin-bottom: var(--space-xs);
        }

        .applicant-job-date {
            font-size: 12px;
            color: var(--text-secondary);
            margin-bottom: 4px;
        }

        .applicant-status {
            display: inline-block;
            padding: 4px 10px;
            border-radius: var(--radius-full);
            font-size: 11px;
            font-weight: 600;
            background: rgba(52, 152, 219, 0.15);
            color: var(--primary);
        }

        .applicant-actions {
            display: flex;
            gap: var(--space-md);
            position: relative;
            z-index: 2;
        }

        .accept-btn,
        .reject-btn {
            flex: 1;
            padding: var(--space-md);
            color: white;
            border: none;
            border-radius: var(--radius-lg);
            cursor: pointer;
            font-weight: 600;
            font-size: 13px;
            transition: all var(--transition-normal);
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 4px;
        }

        .accept-btn {
            background: linear-gradient(135deg, var(--success), var(--success-dark));
            box-shadow: var(--shadow-sm);
        }

        .accept-btn:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-lg);
        }

        .reject-btn {
            background: linear-gradient(135deg, var(--accent), var(--accent-dark));
            box-shadow: var(--shadow-sm);
        }

        .reject-btn:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-lg);
        }

        /* ========== JOB STATUS BADGE ==========*/
        .job-status {
            display: inline-block;
            padding: 6px 14px;
            border-radius: var(--radius-full);
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .status-active {
            background: rgba(39, 174, 96, 0.15);
            color: var(--success);
            border: 1px solid rgba(39, 174, 96, 0.3);
        }

        .status-closed {
            background: rgba(231, 76, 60, 0.15);
            color: var(--accent);
            border: 1px solid rgba(231, 76, 60, 0.3);
        }

        /* ========== EMPTY STATE ==========*/
        .empty-state {
            text-align: center;
            padding: clamp(3rem, 8vw, 5rem) var(--space-lg);
            background: var(--bg-card);
            border-radius: var(--radius-lg);
            animation: fadeIn 0.5s ease-out;
        }

        .empty-state-icon {
            font-size: clamp(48px, 10vw, 80px);
            margin-bottom: var(--space-lg);
        }

        .empty-state-title {
            font-size: clamp(18px, 3vw, 24px);
            color: var(--text-primary);
            margin-bottom: var(--space-sm);
            font-weight: 700;
        }

        .empty-state-text {
            color: var(--text-secondary);
            margin-bottom: var(--space-xl);
            font-size: 14px;
        }

        /* ========== UTILITIES ==========*/
        .hidden {
            display: none !important;
        }

        .visible {
            display: block;
        }

        /* ========== RESPONSIVE DESIGN ==========*/
        @media (max-width: 1024px) {
            .dashboard-container {
                padding: var(--space-lg) var(--space-md);
            }

            .navbar-header {
                padding: var(--space-lg) var(--space-md);
            }

            .stats-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .applicants-grid {
                grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            }

            .content-header {
                flex-direction: column;
                align-items: flex-start;
            }

            .header-actions {
                width: 100%;
            }
        }

        @media (max-width: 768px) {
            :root {
                --space-lg: 1.2rem;
                --space-xl: 1.5rem;
                --space-2xl: 2rem;
            }

            .navbar-header {
                padding: var(--space-md);
                gap: var(--space-md);
            }

            .navbar-brand {
                font-size: 18px;
            }

            .navbar-menu {
                display: none;
            }

            .user-menu {
                gap: var(--space-md);
            }

            .user-name {
                display: none;
            }

            .dashboard-container {
                padding: var(--space-md);
            }

            .welcome-section {
                padding: var(--space-lg);
                margin-bottom: var(--space-lg);
            }

            .welcome-section h1 {
                font-size: 24px;
            }

            .welcome-section p {
                font-size: 14px;
            }

            .stats-grid {
                grid-template-columns: 1fr;
                gap: var(--space-md);
            }

            .stat-card {
                padding: var(--space-lg);
            }

            .dashboard-content {
                padding: var(--space-lg);
                margin-bottom: var(--space-lg);
            }

            .content-header {
                margin-bottom: var(--space-lg);
                padding-bottom: var(--space-md);
            }

            .content-header h2 {
                font-size: 20px;
            }

            .search-input {
                min-width: 100%;
                width: 100%;
            }

            .post-job-btn {
                width: 100%;
                justify-content: center;
            }

            .applicants-grid {
                grid-template-columns: 1fr;
                gap: var(--space-md);
            }

            .applicant-card {
                padding: var(--space-md);
            }

            .applicant-header {
                gap: var(--space-md);
            }

            .applicant-avatar {
                width: 50px;
                height: 50px;
                font-size: 24px;
            }

            .applicant-info h4 {
                font-size: 15px;
            }

            /* Table Responsive */
            .table-wrapper {
                border-radius: var(--radius-md);
            }

            .dashboard-table {
                font-size: 12px;
            }

            .dashboard-table th,
            .dashboard-table td {
                padding: var(--space-md);
            }

            .dashboard-table th {
                font-size: 12px;
            }

            .action-btn {
                padding: 6px 10px;
                font-size: 11px;
                margin-right: 3px;
            }
        }

        @media (max-width: 480px) {
            :root {
                --space-md: 0.75rem;
                --space-lg: 1rem;
                --space-xl: 1.2rem;
                --space-2xl: 1.5rem;
            }

            .navbar-header {
                padding: var(--space-sm);
                flex-wrap: wrap;
            }

            .navbar-brand {
                font-size: 16px;
            }

            .logout-btn {
                padding: var(--space-xs) var(--space-md);
                font-size: 12px;
            }

            .user-avatar {
                width: 36px;
                height: 36px;
                font-size: 18px;
            }

            .dashboard-container {
                padding: var(--space-md);
            }

            .welcome-section {
                padding: var(--space-lg);
                margin-bottom: var(--space-lg);
            }

            .welcome-section h1 {
                font-size: 18px;
                margin-bottom: var(--space-sm);
            }

            .welcome-section p {
                font-size: 12px;
            }

            .stat-card {
                padding: var(--space-lg);
            }

            .stat-card-icon {
                font-size: 24px;
            }

            .stat-card-value {
                font-size: 20px;
            }

            .stat-card-label {
                font-size: 12px;
            }

            .dashboard-content {
                padding: var(--space-md);
                margin-bottom: var(--space-md);
                border-radius: var(--radius-md);
            }

            .content-header {
                margin-bottom: var(--space-md);
                padding-bottom: var(--space-md);
                flex-direction: column;
                align-items: stretch;
            }

            .content-header h2 {
                font-size: 16px;
                margin-bottom: var(--space-md);
            }

            .search-input {
                padding: var(--space-sm) var(--space-md);
                font-size: 13px;
                min-width: 100%;
            }

            .post-job-btn {
                padding: var(--space-sm) var(--space-md);
                font-size: 13px;
                width: 100%;
            }

            .applicants-grid {
                grid-template-columns: 1fr;
                gap: var(--space-md);
            }

            .applicant-card {
                padding: var(--space-md);
                border-radius: var(--radius-md);
            }

            .applicant-header {
                margin-bottom: var(--space-md);
            }

            .applicant-avatar {
                width: 45px;
                height: 45px;
                font-size: 20px;
            }

            .applicant-info h4 {
                font-size: 14px;
            }

            .applicant-info p,
            .applicant-email {
                font-size: 11px;
            }

            .applicant-job {
                padding: var(--space-sm);
                margin-bottom: var(--space-md);
            }

            .applicant-job-title {
                font-size: 13px;
            }

            .applicant-job-date {
                font-size: 11px;
            }

            .accept-btn,
            .reject-btn {
                padding: var(--space-sm);
                font-size: 12px;
            }

            .dashboard-table {
                font-size: 11px;
            }

            .dashboard-table th,
            .dashboard-table td {
                padding: 8px;
            }

            .job-title-cell {
                font-size: 13px;
            }

            .applicant-count {
                padding: 4px 10px;
                font-size: 10px;
            }

            .action-btn {
                padding: 5px 8px;
                font-size: 10px;
                margin-right: 3px;
            }

            .empty-state {
                padding: 2rem var(--space-md);
            }

            .empty-state-icon {
                font-size: 48px;
                margin-bottom: var(--space-md);
            }

            .empty-state-title {
                font-size: 16px;
            }

            .empty-state-text {
                font-size: 12px;
            }
        }

        /* ========== ACCESSIBILITY ==========*/
        @media (prefers-reduced-motion: reduce) {
            * {
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: 0.01ms !important;
                scroll-behavior: auto !important;
            }
        }

        :focus-visible {
            outline: 2px solid var(--primary);
            outline-offset: 2px;
        }

        /* ========== PRINT STYLES ==========*/
        @media print {
            .navbar,
            .header-actions,
            .applicant-actions {
                display: none;
            }

            .dashboard-container {
                padding: 0;
            }

            body {
                background: white;
            }
        }
    </style>
</head>
<body>
    <!-- Dashboard Navbar -->
    <nav class="dashboard-navbar">
        <div class="navbar-header">
            <a href="/" class="navbar-brand">🚀 Job Portal</a>
            <ul class="navbar-menu">
                <li class="nav-item">
                    <a href="/recruiter/dashboard" class="nav-link active">
                        📊 Dashboard
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/recruiter/post-job" class="nav-link">
                        ➕ Post Job
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/recruiter/view-posted-jobs" class="nav-link">
                        📋 My Jobs
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/recruiter/view-applicants" class="nav-link">
                        👥 Applicants
                    </a>
                </li>
            </ul>
            <div class="user-menu">
                <div class="user-info">
                    <div class="user-avatar">👔</div>
                    <span class="user-name"><%=name%></span>
                </div>
                <a href="/" class="logout-btn">Logout</a>
            </div>
        </div>
    </nav>

    <!-- Dashboard Content -->
    <div class="dashboard-container">
        <!-- Welcome Section -->
        <div class="welcome-section">
            <h1>Welcome back, <%=name%>! 👋</h1>
            <p>Manage your job postings, review applicants, and find the perfect candidates for your company.</p>
        </div>

        <!-- Stats Grid -->
        <div class="stats-grid">
            <div class="stat-card posted">
                <div class="stat-card-icon">📢</div>
                <div class="stat-card-value"><%=posted%></div>
                <div class="stat-card-label">Jobs Posted</div>
            </div>
            <div class="stat-card applicants">
                <div class="stat-card-icon">👥</div>
                <div class="stat-card-value"><%=Applicants%></div>
                <div class="stat-card-label">Total Applicants</div>
            </div>
        </div>

        <!-- Posted Jobs Section -->
        <div class="dashboard-content">
            <div class="content-header">
                <h2>📋 Your Job Postings</h2>
                <div class="header-actions">
                    <a href="/recruiter/post-job" class="post-job-btn">➕ Post New Job</a>
                </div>
            </div>

            <% if (job && job.length > 0) { %>
                <div class="table-wrapper">
                    <table class="dashboard-table">
                        <thead>
                            <tr>
                                <th>Job Title</th>
                                <th>Location</th>
                                <th>Salary</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% job.forEach(jobItem => { %>
                                <tr>
                                    <td class="job-title-cell"><%= jobItem.title %></td>
                                    <td><%= jobItem.location %></td>
                                    <td><%= jobItem.salary %></td>
                                    <td>
                                        <a href="/viewpostedJob/<%= jobItem._id %>" class="action-btn view-btn">👁️ View</a>
                                        <a href="/EditPostedJob/<%= jobItem._id %>" class="action-btn edit-btn">✏️ Edit</a>
                                        <a href="/deletePosted/<%= jobItem._id %>" class="action-btn delete-btn">🗑️ Delete</a>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <div class="empty-state">
                    <div class="empty-state-icon">📭</div>
                    <div class="empty-state-title">No Jobs Posted Yet</div>
                    <div class="empty-state-text">Start by posting your first job listing to attract qualified candidates!</div>
                </div>
            <% } %>
        </div>

        <!-- Recent Applicants Section -->
        <div class="dashboard-content">
            <div class="content-header">
                <h2>👥 Recent Applicants</h2>
            </div>

            <% if (user1 && user1.length > 0) { %>
                <div class="applicants-grid">
                    <% user1.forEach(user => { %>
                        <div class="applicant-card">
                            <div class="applicant-header">
                                <div class="applicant-avatar">👨</div>
                                <div class="applicant-info">
                                    <h4><%= user.name %></h4>
                                    <p class="applicant-email"><%= user.candidate %></p>
                                    <p><%= user.locationCandidate %></p>
                                </div>
                            </div>
                            <div class="applicant-job">
                                <div class="applicant-job-title"><%= user.title %></div>
                                <div class="applicant-status"><%= user.status %></div>
                            </div>
                            <div class="applicant-actions">
                                <a href="/Accept/<%= user._id %>" class="accept-btn">✓ Accept</a>
                                <a href="/Reject/<%= user._id %>" class="reject-btn">✕ Reject</a>
                            </div>
                        </div>
                    <% }); %>
                </div>
            <% } else { %>
                <div class="empty-state">
                    <div class="empty-state-icon">📭</div>
                    <div class="empty-state-title">No Applicants Yet</div>
                    <div class="empty-state-text">Your applicants will appear here as they apply to your job listings.</div>
                </div>
            <% } %>
        </div>
    </div>
</body>
</html>
