<!DOCTYPE html>
<html>
<head>
    <title>My Profile</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        /* ========== PROFILE PAGE SPECIFIC STYLES ==========*/
        
        .page-title {
            font-size: clamp(var(--font-size-2xl), 5vw, var(--font-size-4xl));
            font-weight: var(--font-weight-black);
            color: var(--text-primary);
            margin-bottom: var(--space-2xl);
            display: flex;
            align-items: center;
            gap: var(--space-md);
            letter-spacing: -0.02em;
        }

        .profile-section {
            background: var(--bg-card);
            padding: var(--space-2xl);
            border-radius: var(--radius-2xl);
            box-shadow: var(--shadow-lg);
            margin-bottom: var(--space-2xl);
            animation: slideInUp 0.6s ease-out;
            border: 1px solid var(--border);
            position: relative;
            overflow: hidden;
        }

        .profile-section::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, var(--primary), var(--secondary), var(--accent));
            animation: shimmer 3s infinite;
        }

        @keyframes shimmer {
            0%, 100% { transform: translateX(-100%); }
            50% { transform: translateX(100%); }
        }

        .section-title {
            font-size: clamp(var(--font-size-xl), 3vw, var(--font-size-2xl));
            font-weight: var(--font-weight-bold);
            color: var(--text-primary);
            margin-bottom: var(--space-xl);
            padding-bottom: var(--space-lg);
            border-bottom: 2px solid var(--border);
            display: flex;
            align-items: center;
            gap: var(--space-md);
            letter-spacing: -0.01em;
        }

        .section-title::before {
            content: '';
            display: inline-block;
            width: 4px;
            height: 24px;
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            border-radius: 2px;
        }

        /* ========== PROFILE GRID ==========*/
        .profile-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: var(--space-lg);
            margin-bottom: var(--space-xl);
        }

        .profile-item {
            background: linear-gradient(135deg, var(--bg-hover) 0%, var(--bg-primary) 100%);
            padding: var(--space-lg);
            border-radius: var(--radius-xl);
            border-left: 4px solid var(--primary);
            border: 2px solid var(--border);
            transition: all var(--transition-normal);
            cursor: default;
            position: relative;
            overflow: hidden;
        }

        .profile-item::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
            transition: left 0.5s;
        }

        .profile-item:hover::before {
            left: 100%;
        }

        .profile-item:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-lg);
            border-left-color: var(--secondary);
        }

        .profile-label {
            color: var(--text-secondary);
            font-size: var(--font-size-xs);
            font-weight: var(--font-weight-semibold);
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: var(--space-sm);
            display: flex;
            align-items: center;
            gap: var(--space-xs);
        }

        .profile-value {
            color: var(--text-primary);
            font-size: clamp(var(--font-size-base), 2vw, var(--font-size-lg));
            font-weight: var(--font-weight-semibold);
            word-break: break-word;
        }

        .profile-value.empty {
            color: var(--text-muted);
            font-style: italic;
            opacity: 0.7;
        }

        /* ========== FORM STYLES ==========*/
        .edit-modal {
            display: none;
            animation: slideInUp 0.4s ease-out;
        }

        .edit-modal.active {
            display: block;
        }

        .form-group {
            margin-bottom: var(--space-xl);
        }

        .form-row {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: var(--space-lg);
        }

        label {
            display: block;
            margin-bottom: var(--space-md);
            font-weight: var(--font-weight-semibold);
            color: var(--text-primary);
            font-size: var(--font-size-sm);
            letter-spacing: 0.025em;
            text-transform: uppercase;
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        input[type="text"],
        input[type="email"],
        input[type="password"],
        input[type="tel"],
        input[type="date"],
        input[type="number"],
        textarea,
        select {
            width: 100%;
            padding: var(--space-md) var(--space-lg);
            border: 2px solid var(--border);
            border-radius: var(--radius-lg);
            font-size: var(--font-size-base);
            font-family: inherit;
            background: var(--bg-secondary);
            color: var(--text-primary);
            transition: all var(--transition-normal);
        }

        input::placeholder,
        textarea::placeholder {
            color: var(--text-muted);
        }

        input:focus,
        textarea:focus,
        select:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgb(30 58 138 / 0.1);
            transform: translateY(-2px);
        }

        textarea {
            resize: vertical;
            min-height: 100px;
        }

        small {
            display: block;
            color: var(--text-secondary);
            font-size: var(--font-size-xs);
            margin-top: var(--space-sm);
            font-style: italic;
        }

        /* ========== BUTTON CONTAINER ==========*/
        .btn-container {
            display: flex;
            gap: var(--space-lg);
            justify-content: flex-end;
            margin-top: var(--space-2xl);
            padding-top: var(--space-xl);
            border-top: 2px solid var(--border);
            flex-wrap: wrap;
        }

        .btn,
        button[type="submit"],
        button[type="button"] {
            padding: var(--space-md) var(--space-xl);
            border: none;
            border-radius: var(--radius-lg);
            cursor: pointer;
            font-weight: var(--font-weight-semibold);
            font-size: var(--font-size-base);
            text-decoration: none;
            transition: all var(--transition-normal);
            position: relative;
            overflow: hidden;
            display: inline-flex;
            align-items: center;
            gap: var(--space-sm);
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .btn::before,
        button[type="submit"]::before,
        button[type="button"]::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
            transition: left 0.5s;
            z-index: 1;
        }

        .btn:hover::before,
        button[type="submit"]:hover::before,
        button[type="button"]:hover::before {
            left: 100%;
        }

        /* Edit Button */
        .btn-edit,
        button.btn-edit {
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            color: white;
            box-shadow: var(--shadow-md);
            position: relative;
            z-index: 0;
        }

        .btn-edit:hover,
        button.btn-edit:hover {
            transform: translateY(-3px);
            box-shadow: var(--shadow-xl);
        }

        .btn-edit:active,
        button.btn-edit:active {
            transform: translateY(-1px);
        }

        /* Save Button */
        .btn-save,
        button[type="submit"],
        button.btn-save {
            background: linear-gradient(135deg, var(--success), var(--accent-dark));
            color: white;
            box-shadow: var(--shadow-md);
            position: relative;
            z-index: 0;
        }

        .btn-save:hover,
        button[type="submit"]:hover,
        button.btn-save:hover {
            transform: translateY(-3px);
            box-shadow: var(--shadow-xl);
        }

        .btn-save:active,
        button[type="submit"]:active,
        button.btn-save:active {
            transform: translateY(-1px);
        }

        /* Cancel Button */
        .btn-cancel,
        button.btn-cancel {
            background-color: var(--bg-hover);
            color: var(--text-primary);
            border: 2px solid var(--border);
            box-shadow: var(--shadow-sm);
        }

        .btn-cancel:hover,
        button.btn-cancel:hover {
            background-color: var(--border);
            transform: translateY(-2px);
            box-shadow: var(--shadow-lg);
        }

        /* Logout Button */
        .logout-btn {
            background: linear-gradient(135deg, var(--danger), var(--danger-dark));
            color: white;
            border: none;
            padding: var(--space-sm) var(--space-lg);
            border-radius: var(--radius-lg);
            cursor: pointer;
            font-weight: var(--font-weight-semibold);
            text-decoration: none;
            transition: all var(--transition-normal);
            box-shadow: var(--shadow-md);
            display: inline-flex;
            align-items: center;
            gap: var(--space-sm);
            text-transform: uppercase;
            letter-spacing: 0.025em;
            font-size: var(--font-size-sm);
        }

        .logout-btn:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-lg);
        }

        .logout-btn:active {
            transform: translateY(0);
        }

        /* ========== RESPONSIVE DESIGN ==========*/
        @media (max-width: 768px) {
            .container {
                padding: 0 var(--space-lg);
            }

            .profile-section {
                padding: var(--space-xl);
            }

            .profile-grid {
                grid-template-columns: 1fr;
                gap: var(--space-md);
            }

            .form-row {
                grid-template-columns: 1fr;
            }

            .btn-container {
                flex-direction: column;
            }

            .btn,
            button[type="submit"],
            button[type="button"],
            button.btn-save,
            button.btn-cancel,
            button.btn-edit {
                width: 100%;
                justify-content: center;
            }

            .page-title {
                font-size: var(--font-size-2xl);
            }

            .section-title {
                font-size: var(--font-size-xl);
            }
        }

        @media (max-width: 480px) {
            .container {
                padding: 0 var(--space-md);
            }

            .profile-section {
                padding: var(--space-lg);
                margin-bottom: var(--space-lg);
                border-radius: var(--radius-lg);
            }

            .profile-grid {
                grid-template-columns: 1fr;
                gap: var(--space-sm);
            }

            .profile-item {
                padding: var(--space-md);
            }

            .profile-value {
                font-size: var(--font-size-sm);
            }

            .section-title {
                font-size: var(--font-size-lg);
                margin-bottom: var(--space-md);
            }

            .btn-container {
                gap: var(--space-md);
                padding-top: var(--space-md);
                margin-top: var(--space-lg);
            }

            .btn,
            button[type="submit"],
            button[type="button"],
            button.btn-save,
            button.btn-cancel,
            button.btn-edit {
                padding: var(--space-sm) var(--space-md);
                font-size: var(--font-size-sm);
            }

            input[type="text"],
            input[type="email"],
            input[type="tel"],
            input[type="date"],
            input[type="number"],
            textarea,
            select {
                padding: var(--space-sm) var(--space-md);
                font-size: var(--font-size-sm);
            }

            label {
                font-size: var(--font-size-xs);
            }
        }

        /* ========== ANIMATIONS ==========*/
        @keyframes slideInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* ========== DARK MODE ==========*/
        @media (prefers-color-scheme: dark) {
            .profile-item {
                background: linear-gradient(135deg, var(--bg-hover) 0%, var(--bg-primary) 100%);
            }

            input[type="text"],
            input[type="email"],
            input[type="tel"],
            input[type="date"],
            input[type="number"],
            textarea,
            select {
                background: var(--bg-secondary);
            }

            .btn-cancel,
            button.btn-cancel {
                background-color: var(--bg-hover);
                border-color: var(--border);
            }
        }
    </style>
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar">
        <div class="navbar-container">
            <a href="/" class="navbar-brand">🚀 Job Portal</a>
            <div class="nav-links">
                <a href="/dashboard">📊 Dashboard</a>
                <a href="/candidate/profile" style="color: var(--primary); font-weight: bold;">👤 Profile</a>
                <a href="/candidate/login" class="logout-btn">🚪 Logout</a>
            </div>
        </div>
    </nav>

    <!-- Container -->
    <div class="container">
        <div class="page-title">👤 My Profile</div>

        <!-- Personal Information Section -->
        <div class="profile-section">
            <div class="section-title">📋 Personal Information</div>

            <div class="profile-grid">
                <div class="profile-item">
                    <div class="profile-label">👤 Full Name</div>
                    <div class="profile-value <%= !candidate.name ? 'empty' : '' %>"><%= candidate.name || 'Not added' %></div>
                </div>

                <div class="profile-item">
                    <div class="profile-label">📧 Email</div>
                    <div class="profile-value <%= !candidate.email ? 'empty' : '' %>"><%= candidate.email || 'Not added' %></div>
                </div>

                <div class="profile-item">
                    <div class="profile-label">📞 Phone</div>
                    <div class="profile-value <%= !candidate.phone ? 'empty' : '' %>"><%= candidate.phone || 'Not added' %></div>
                </div>

                <div class="profile-item">
                    <div class="profile-label">📍 Location</div>
                    <div class="profile-value <%= !candidate.location ? 'empty' : '' %>"><%= candidate.location || 'Not added' %></div>
                </div>
            </div>

            <div class="btn-container">
                <button id="editPersonalBtn" class="btn btn-edit">✏️ Edit</button>
            </div>
        </div>

        <!-- Edit Personal Info Modal -->
        <div id="editPersonalModal" class="profile-section edit-modal">
            <div class="section-title">✏️ Edit Personal Information</div>

            <form method="POST" action="/candidate/update">
                <div class="form-row">
                    <div class="form-group">
                        <label for="name">Full Name</label>
                        <input type="text" id="name" name="name" value="<%= candidate.name || '' %>" required>
                    </div>

                    <div class="form-group">
                        <label for="phone">Phone Number</label>
                        <input type="tel" id="phone" name="phone" value="<%= candidate.phone || '' %>">
                    </div>
                </div>

                <div class="form-group">
                    <label for="location">Location</label>
                    <input type="text" id="location" name="location" placeholder="City, Country" value="<%= candidate.location || '' %>">
                </div>

                <div class="btn-container">
                    <button type="button" id="closePersonalBtn" class="btn btn-cancel">❌ Cancel</button>
                    <button type="submit" class="btn btn-save">💾 Save</button>
                </div>
            </form>
        </div>

        <!-- Skills Section -->
        <div class="profile-section">
            <div class="section-title">💼 Skills</div>

            <div class="profile-item">
                <div class="profile-label">Your Skills</div>
                <div class="profile-value <%= !candidate.skills ? 'empty' : '' %>"><%= candidate.skills || 'Not added' %></div>
            </div>

            <div class="btn-container">
                <button id="editSkillsBtn" class="btn btn-edit">✏️ Edit</button>
            </div>
        </div>

        <!-- Edit Skills Modal -->
        <div id="editSkillsModal" class="profile-section edit-modal">
            <div class="section-title">✏️ Edit Skills</div>

            <form method="POST" action="/candidate/update">
                <div class="form-group">
                    <label for="skills">Add Your Skills</label>
                    <textarea id="skills" name="skills" placeholder="JavaScript, React, Node.js, MongoDB..."><%= candidate.skills || '' %></textarea>
                    <small>Separate skills with commas</small>
                </div>

                <div class="btn-container">
                    <button type="button" id="closeSkillsBtn" class="btn btn-cancel">❌ Cancel</button>
                    <button type="submit" class="btn btn-save">💾 Save</button>
                </div>
            </form>
        </div>

        <!-- Education Section -->
        <div class="profile-section">
            <div class="section-title">🎓 Education</div>

            <div class="profile-item">
                <div class="profile-label">Your Education</div>
                <div class="profile-value <%= !candidate.degree ? 'empty' : '' %>"><%= candidate.degree || 'Not added' %></div>
            </div>

            <div class="btn-container">
                <button id="editEducationBtn" class="btn btn-edit">✏️ Edit</button>
            </div>
        </div>

        <!-- Edit Education Modal -->
        <div id="editEducationModal" class="profile-section edit-modal">
            <div class="section-title">✏️ Edit Education</div>

            <form method="POST" action="/candidate/update">
                <div class="form-row">
                    <div class="form-group">
                        <label for="degree">Degree</label>
                        <input type="text" id="degree" name="degree" placeholder="B.Tech Computer Science" value="<%= candidate.degree || '' %>">
                    </div>

                    <div class="form-group">
                        <label for="university">University/College</label>
                        <input type="text" id="university" name="university" placeholder="MIT" value="<%= candidate.university || '' %>">
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="gradYear">Graduation Year</label>
                        <input type="number" id="gradYear" name="gradYear" placeholder="2023" value="<%= candidate.gradYear || '' %>">
                    </div>

                    <div class="form-group">
                        <label for="field">Field of Study</label>
                        <input type="text" id="field" name="field" placeholder="Computer Science" value="<%= candidate.field || '' %>">
                    </div>
                </div>

                <div class="btn-container">
                    <button type="button" id="closeEducationBtn" class="btn btn-cancel">❌ Cancel</button>
                    <button type="submit" class="btn btn-save">💾 Save</button>
                </div>
            </form>
        </div>

        <!-- Experience Section -->
        <div class="profile-section">
            <div class="section-title">📈 Experience</div>

            <div class="profile-item">
                <div class="profile-label">Your Experience</div>
                <div class="profile-value <%= !candidate.jobTitle ? 'empty' : '' %>"><%= candidate.jobTitle || 'Not added' %></div>
            </div>

            <div class="btn-container">
                <button id="editExperienceBtn" class="btn btn-edit">✏️ Edit</button>
            </div>
        </div>

        <!-- Edit Experience Modal -->
        <div id="editExperienceModal" class="profile-section edit-modal">
            <div class="section-title">✏️ Edit Experience</div>

            <form method="POST" action="/candidate/update">
                <div class="form-row">
                    <div class="form-group">
                        <label for="jobTitle">Job Title</label>
                        <input type="text" id="jobTitle" name="jobTitle" placeholder="Senior Developer" value="<%= candidate.jobTitle || '' %>">
                    </div>

                    <div class="form-group">
                        <label for="company">Company</label>
                        <input type="text" id="company" name="company" placeholder="Tech Corp" value="<%= candidate.company || '' %>">
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="startDate">Start Date</label>
                        <input type="date" id="startDate" name="startDate" value="<%= candidate.startDate || '' %>">
                    </div>

                    <div class="form-group">
                        <label for="endDate">End Date</label>
                        <input type="date" id="endDate" name="endDate" value="<%= candidate.endDate || '' %>">
                    </div>
                </div>

                <div class="form-group">
                    <label for="expDescription">Description</label>
                    <textarea id="expDescription" name="expDescription" placeholder="Describe your role and achievements..."><%= candidate.expDescription || '' %></textarea>
                </div>

                <div class="btn-container">
                    <button type="button" id="closeExperienceBtn" class="btn btn-cancel">❌ Cancel</button>
                    <button type="submit" class="btn btn-save">💾 Save</button>
                </div>
            </form>
        </div>
    </div>

    <footer class="footer">
        <div class="footer-content">
            <div class="footer-links">
                <a href="#about">About</a>
                <a href="#">Privacy Policy</a>
                <a href="#">Terms & Conditions</a>
                <a href="#">Contact</a>
            </div>
            <div class="footer-bottom">
                <p>&copy; 2026 Job Portal System. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <script src="/js/profile.js"></script>
</body>
</html>
