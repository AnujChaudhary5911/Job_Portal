
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Candidate Profile - Job Portal</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar">
        <div class="navbar-container">
            <a href="/" class="navbar-brand">🚀 Job Portal</a>
            <ul class="nav-links">
                <li><a href="/Rdashboard">Dashboard</a></li>
                <li><a href="/recruiter/view-applicants">Applicants</a></li>
                <li><a href="/">Logout</a></li>
            </ul>
        </div>
    </nav>

    <!-- Container -->
    <div class="container">
        <a href="/recruiter/view-applicants" style="color: var(--primary); text-decoration: none; font-weight: 600; margin-bottom: var(--space-lg); display: inline-block; transition: all var(--transition-normal);">← Back to Applicants</a>

        <!-- Page Header -->
        <div class="page-header">
            <h1>👤 <%= user.name %></h1>
            <p>📧 <%= user.email %></p>
        </div>

        <!-- Card -->
        <div style="background: var(--bg-card); padding: var(--space-2xl); border-radius: var(--radius-xl); box-shadow: var(--shadow-lg); margin: var(--space-2xl) auto; max-width: 1000px;">
            
            <!-- Info Grid - 3 Columns -->
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: var(--space-lg); margin-bottom: var(--space-2xl);">
                
                <div style="background: var(--bg-hover); padding: var(--space-lg); border-radius: var(--radius-lg); border-left: 4px solid var(--primary);">
                    <div style="color: var(--text-secondary); font-size: var(--font-size-xs); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: var(--space-sm);">📍 Location</div>
                    <div style="color: var(--text-primary); font-size: var(--font-size-base); font-weight: 600;"><%= user.location || 'N/A' %></div>
                </div>

                <div style="background: var(--bg-hover); padding: var(--space-lg); border-radius: var(--radius-lg); border-left: 4px solid var(--primary);">
                    <div style="color: var(--text-secondary); font-size: var(--font-size-xs); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: var(--space-sm);">💼 Skills</div>
                    <div style="color: var(--text-primary); font-size: var(--font-size-base); font-weight: 600;"><%= user.skills || 'N/A' %></div>
                </div>

                <div style="background: var(--bg-hover); padding: var(--space-lg); border-radius: var(--radius-lg); border-left: 4px solid var(--primary);">
                    <div style="color: var(--text-secondary); font-size: var(--font-size-xs); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: var(--space-sm);">📞 Phone</div>
                    <div style="color: var(--text-primary); font-size: var(--font-size-base); font-weight: 600;"><%= user.phone || 'N/A' %></div>
                </div>

                <div style="background: var(--bg-hover); padding: var(--space-lg); border-radius: var(--radius-lg); border-left: 4px solid var(--primary);">
                    <div style="color: var(--text-secondary); font-size: var(--font-size-xs); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: var(--space-sm);">🎓 Degree</div>
                    <div style="color: var(--text-primary); font-size: var(--font-size-base); font-weight: 600;"><%= user.degree || 'N/A' %></div>
                </div>

                <div style="background: var(--bg-hover); padding: var(--space-lg); border-radius: var(--radius-lg); border-left: 4px solid var(--primary);">
                    <div style="color: var(--text-secondary); font-size: var(--font-size-xs); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: var(--space-sm);">📚 Field of Study</div>
                    <div style="color: var(--text-primary); font-size: var(--font-size-base); font-weight: 600;"><%= user.field || 'N/A' %></div>
                </div>

                <div style="background: var(--bg-hover); padding: var(--space-lg); border-radius: var(--radius-lg); border-left: 4px solid var(--primary);">
                    <div style="color: var(--text-secondary); font-size: var(--font-size-xs); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: var(--space-sm);">🎓 Graduation Year</div>
                    <div style="color: var(--text-primary); font-size: var(--font-size-base); font-weight: 600;"><%= user.gradYear || 'N/A' %></div>
                </div>

                <div style="background: var(--bg-hover); padding: var(--space-lg); border-radius: var(--radius-lg); border-left: 4px solid var(--primary);">
                    <div style="color: var(--text-secondary); font-size: var(--font-size-xs); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: var(--space-sm);">🏫 University</div>
                    <div style="color: var(--text-primary); font-size: var(--font-size-base); font-weight: 600;"><%= user.university || 'N/A' %></div>
                </div>

                <div style="background: var(--bg-hover); padding: var(--space-lg); border-radius: var(--radius-lg); border-left: 4px solid var(--primary);">
                    <div style="color: var(--text-secondary); font-size: var(--font-size-xs); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: var(--space-sm);">💼 Current Job Title</div>
                    <div style="color: var(--text-primary); font-size: var(--font-size-base); font-weight: 600;"><%= user.jobTitle || 'N/A' %></div>
                </div>
            </div>

            <!-- Experience Section -->
            <div style="margin-top: var(--space-2xl); padding: var(--space-lg); background: var(--bg-hover); border-radius: var(--radius-lg); border-left: 4px solid var(--accent);">
                <h2 style="color: var(--text-primary); font-size: var(--font-size-lg); font-weight: 700; margin-bottom: var(--space-lg);">📈 Work Experience</h2>
                
                <div style="display: grid; gap: var(--space-md);">
                    <div>
                        <p style="color: var(--text-secondary); font-size: var(--font-size-sm); margin-bottom: 0.25rem;"><strong>Company:</strong> <%= user.company || 'Not provided' %></p>
                        <p style="color: var(--text-secondary); font-size: var(--font-size-sm); margin-bottom: 0.25rem;"><strong>Start Date:</strong> <%= user.startDate || 'Not provided' %></p>
                        <p style="color: var(--text-secondary); font-size: var(--font-size-sm); margin-bottom: 0.25rem;"><strong>End Date:</strong> <%= user.endDate || 'Not provided' %></p>
                        <p style="color: var(--text-secondary); font-size: var(--font-size-sm); line-height: var(--line-height-relaxed);"><strong>Description:</strong> <%= user.expDescription || 'Not provided' %></p>
                    </div>
                </div>
            </div>

            <!-- About Section -->
            <div style="margin-top: var(--space-2xl); padding-top: var(--space-2xl); border-top: 2px solid var(--border);">
                <h2 style="color: var(--text-primary); font-size: var(--font-size-lg); font-weight: 700; margin-bottom: var(--space-lg);">📋 Profile Summary</h2>
                <p style="color: var(--text-secondary); font-size: var(--font-size-base); line-height: var(--line-height-relaxed);"><%= user.summary || 'No summary provided' %></p>
            </div>

            <!-- Action Buttons -->
            <div style="margin-top: var(--space-2xl); display: flex; gap: var(--space-md); justify-content: flex-end; flex-wrap: wrap;">
                <a href="/recruiter/view-applicants" style="padding: var(--space-md) var(--space-xl); background-color: #ecf0f1; color: var(--text-primary); border: none; border-radius: var(--radius-lg); cursor: pointer; font-weight: 600; text-decoration: none; display: inline-block; transition: all var(--transition-normal);">← Back</a>
                
                <form action="/Accept/<%= idJob %>" method="get" style="display: inline;">
                    <button type="submit" style="padding: var(--space-md) var(--space-xl); background: linear-gradient(135deg, var(--success), var(--accent-dark)); color: white; border: none; border-radius: var(--radius-lg); cursor: pointer; font-weight: 600; text-decoration: none; display: inline-block; transition: all var(--transition-normal);">✅ Accept</button>
                </form>
                
                <form action="/Reject/<%= idJob %>" method="get" style="display: inline;">
                    <button type="submit" style="padding: var(--space-md) var(--space-xl); background: linear-gradient(135deg, var(--danger), var(--danger-dark)); color: white; border: none; border-radius: var(--radius-lg); cursor: pointer; font-weight: 600; text-decoration: none; display: inline-block; transition: all var(--transition-normal);">❌ Reject</button>
                </form>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="footer">
        <div class="footer-content">
            <div class="footer-links">
                <a href="#about">About</a>
                <a href="#">Privacy Policy</a>
                <a href="#">Terms & Conditions</a>
                <a href="#">Contact</a>
            </div>
            <div class="footer-bottom">
                <p>&copy; 2026 Job Portal System. All rights reserved.</p>
            </div>
        </div>
    </footer>
</body>
</html>
